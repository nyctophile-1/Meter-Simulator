    {
        TestTaskType.PushLoop => "tbadge-push",
        TestTaskType.PullListener => "tbadge-pull",
        TestTaskType.BurstPush => "tbadge-burst",
        TestTaskType.PartialPush => "tbadge-burst",
        _ => "",
    };

    private static string ShortType(TestTaskType t) => t switch
    {
        TestTaskType.PushLoop => "loop",
        TestTaskType.PullListener => "pull",
        TestTaskType.BurstPush => "push",
        TestTaskType.PartialPush => "partial push",
        _ => t.ToString(),
    };

    private static string RelativeTime(DateTimeOffset? when)
    {
        if (when is null) return "--";
        TimeSpan d = when.Value - DateTimeOffset.UtcNow;
        return d.TotalSeconds switch { > 0 and < 60 => $"in {d.TotalSeconds:F0}s", > 0 => $"in {d.TotalMinutes:F0}m", > -60 => $"{-d.TotalSeconds:F0}s ago", _ => $"{-d.TotalMinutes:F0}m ago" };
    }

    private static string FormatDuration(TimeSpan t) =>
        t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : $"{t.Minutes}m {t.Seconds}s";

    private static Color StatusColor(BatchStatus s) => s switch { BatchStatus.Running => Color.Success, BatchStatus.Starting => Color.Info, BatchStatus.Stopped => Color.Error, _ => Color.Default };
    private static string StatusRowClass(BatchStatus s) => s switch { BatchStatus.Running => "is-running", BatchStatus.Starting => "is-starting", BatchStatus.Stopped => "is-stopped", _ => "is-idle" };
    private static string NicLabel(NicType n) => n switch { NicType.Tcp4G => "4G TCP", NicType.Mqtt4G => "4G MQTT", NicType.Mqtt4GImg => "4G IMG", NicType.MqttWirepas => "RF Wirepas", NicType.MqttKmesh => "RF Kmesh", _ => n.ToString() };


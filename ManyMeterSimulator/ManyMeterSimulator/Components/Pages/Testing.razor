@page "/testing"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ManyMeterSimulator.Brain
@using ManyMeterSimulator.Networking.Nic
@using ManyMeterSimulator.Networking.Registry
@using ManyMeterSimulator.Provisioning
@using ManyMeterSimulator.Testing
@inject MeterRegistry MeterRegistry
@inject NetworkRegistry Network
@inject PushCoordinator Push
@inject PushScheduleService Schedule
@inject ConfigBundleService ConfigBundles
@inject TestPlanRegistry TestPlans
@inject TestRunEngine RunEngine
@inject TestRunStore RunStore
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>MAYA - Testing</PageTitle>

@* Active-run status banner *@
@if (_activeRun is { } run)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4"
              Style="@($"border-left:4px solid var(--mud-palette-{RunStatusColor(run.Status)})")">
        <div class="d-flex align-center justify-space-between flex-wrap" style="gap:8px;">
            <div>
                <MudText Typo="Typo.subtitle1">
                    <strong>@run.PlanName</strong>
                    <MudChip T="string" Size="Size.Small" Color="@RunStatusMudColor(run.Status)"
                             Variant="Variant.Filled" Class="ml-2">@run.Status</MudChip>
                </MudText>
                @if (run.Status == TestRunStatus.Scheduled)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Starts @RelativeTime(run.ScheduledStartUtc)
                    </MudText>
                }
                else if (run.Status == TestRunStatus.Running)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Tick @run.CompletedTicks / @run.ExpectedTicks
                        @if (run.NextTickUtc is not null) { <text> &mdash; next tick @RelativeTime(run.NextTickUtc)</text> }
                    </MudText>
                    @if (run.LastTickSummary is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@run.LastTickSummary</MudText>
                    }
                }
            </div>
            <div class="d-flex align-center" style="gap:8px;">
                @if (run.Status is TestRunStatus.Running or TestRunStatus.Scheduled)
                {
                    <MudProgressLinear Value="@run.ElapsedPct" Color="Color.Primary"
                                       Style="width:160px;" Rounded="true" Size="Size.Small" />
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                               OnClick="CancelRun">Cancel</MudButton>
                }
            </div>
        </div>
    </MudPaper>
}

<MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="false" PanelClass="pt-4">

    @* ============ Tab 1 - Push ============ *@
    <MudTabPanel Text="Push">
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Ad-hoc checks against a live batch. Export/import of the loop-push schedule lives on the
            <MudLink Href="/config">Configuration</MudLink> page.
        </MudText>

        <MudPaper Elevation="1" Class="pa-4 mb-6">
            <div class="d-flex align-center justify-space-between flex-wrap" style="gap:12px;">
                <div>
                    <MudText Typo="Typo.h6">On-demand push</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Pushes every meter in a batch right now.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Loop" OnClick="OpenLoopDialog"
                           Disabled="@_testRunActive">
                    Configure loop push
                </MudButton>
            </div>

            @if (_scheduleState.IntervalMinutes > 0)
            {
                <MudAlert Severity="@(_scheduleState.IsRunning ? Severity.Info : Severity.Normal)"
                          Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    @if (_scheduleState.IsRunning)
                    {
                        <text>
                            Looping push every @_scheduleState.IntervalMinutes min over @_scheduleState.BatchIds.Count batch(es).
                            Next run @RelativeTime(_scheduleState.NextRunUtc).
                        </text>
                    }
                    else
                    {
                        <text>Loop push stopped.</text>
                    }
                    @if (_scheduleState.LastSummary is not null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                            Last run @RelativeTime(_scheduleState.LastRunUtc): @_scheduleState.LastSummary
                        </MudText>
                    }
                    @if (_scheduleState.IsRunning)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="mt-1"
                                   OnClick="StopLoop">Stop loop</MudButton>
                    }
                </MudAlert>
            }

            @if (_testRunActive)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    A test run is active &mdash; on-demand push is disabled until it completes.
                </MudAlert>
            }

            @if (_batches.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">No batches yet.</MudText>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true" Bordered="false" Class="batch-table mt-3">
                    <thead>
                        <tr>
                            <th>NIC</th>
                            <th class="col-flex">Name</th>
                            <th style="text-align:right">Count</th>
                            <th>Status</th>
                            <th style="text-align:right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MeterBatch b in _batches)
                        {
                            <tr class="batch-row @StatusRowClass(b.Status)">
                                <td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@NicLabel(b.NicType)</MudChip></td>
                                <td class="col-flex">
                                    @b.Name
                                    @if (_scheduleState.IsRunning && _scheduleState.BatchIds.Contains(b.Id))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Class="ml-2">looping</MudChip>
                                    }
                                </td>
                                <td style="text-align:right">@b.Count.ToString("N0")</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(b.Status)">
                                        @b.Status
                                    </MudChip>
                                </td>
                                <td style="text-align:right">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Send"
                                               Disabled="@(_pushingBatchIds.Contains(b.Id) || _testRunActive)"
                                               OnClick="@(() => SendPushAsync(b.Id))">
                                        @(_pushingBatchIds.Contains(b.Id) ? "Sending..." : "Send Push")
                                    </MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudTabPanel>

    @* ============ Tab 2 - Test Plans ============ *@
    <MudTabPanel Text="Test Plans">
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Structured benchmark runs. The <strong>Base Plan</strong> uses a fixed 5-min push cadence
            and 15-min collection window &mdash; the common baseline every team measures against.
            Export/import lives on the <MudLink Href="/config">Configuration</MudLink> page.
        </MudText>

        <div class="d-flex justify-end mb-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddPlan">
                Add plan
            </MudButton>
        </div>

        @if (_plans.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No plans yet.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true" Bordered="false" Class="batch-table">
                <thead>
                    <tr>
                        <th class="col-flex">Name</th>
                        <th>Push interval</th>
                        <th>Duration</th>
                        <th>Environments</th>
                        <th>Batches</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TestPlan plan in _plans)
                    {
                        <tr class="batch-row is-idle">
                            <td class="col-flex">
                                <strong>@plan.DisplayName</strong>
                                @if (plan.IsBasePlan)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ml-1">base</MudChip>
                                }
                            </td>
                            <td>
                                @(plan.PushIntervalSec / 60) min
                                @if (plan.IsFieldLocked(nameof(TestPlan.PushIntervalSec)))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="ml-1 mud-text-secondary" Style="vertical-align:middle;font-size:14px;" />
                                }
                            </td>
                            <td>
                                @plan.CollectionDurationMin min
                                @if (plan.IsFieldLocked(nameof(TestPlan.CollectionDurationMin)))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="ml-1 mud-text-secondary" Style="vertical-align:middle;font-size:14px;" />
                                }
                            </td>
                            <td>
                                @if (plan.EnvironmentKeys.Count == 0)
                                {
                                    <span class="mud-text-secondary">all</span>
                                }
                                else
                                {
                                    @foreach (string key in plan.EnvironmentKeys)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1">@key</MudChip>
                                    }
                                }
                            </td>
                            <td>
                                @{
                                    var names = plan.BatchIds
                                        .Select(id => _batches.FirstOrDefault(b => b.Id == id)?.Name)
                                        .Where(n => n is not null).ToList();
                                }
                                @if (names.Count == 0)
                                {
                                    <span class="mud-text-secondary">none</span>
                                }
                                else
                                {
                                    @foreach (string? name in names)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1">@name</MudChip>
                                    }
                                }
                            </td>
                            <td style="text-align:right">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           Disabled="@_testRunActive"
                                           OnClick="@(() => OpenRunDialog(plan))">Run</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                                           OnClick="@(() => OpenEditPlan(plan))">Edit</MudButton>
                                @if (!plan.IsBasePlan)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" Class="ml-1"
                                               OnClick="@(() => DeletePlan(plan))">Delete</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>

    @* ============ Tab 3 - Results ============ *@
    <MudTabPanel Text="Results">
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Every completed run is saved here. Select two or more to compare side by side.
            <strong>BenchScore</strong> = throughput / (1 + P95 latency sec) &times; success%.
            Higher is better.
        </MudText>

        @if (_reports.Count == 0)
        {
            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
                No results yet. Run a test plan from the Test Plans tab.
            </MudAlert>
        }
        else
        {
            @* Run list *@
            <MudSimpleTable Hover="true" Dense="true" Bordered="false" Class="batch-table mb-6">
                <thead>
                    <tr>
                        <th style="width:36px;"></th>
                        <th>Date</th>
                        <th class="col-flex">Plan</th>
                        <th>Environments</th>
                        <th style="text-align:right">BenchScore</th>
                        <th style="text-align:right">Success</th>
                        <th>Status</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TestRunReport r in _reports)
                    {
                        bool sel = _selectedRunIds.Contains(r.RunId);
                        <tr class="batch-row @(r.FinalStatus == TestRunStatus.Completed ? "is-idle" : "is-stopped")"
                            style="cursor:pointer;" @onclick="@(() => ToggleRunSelection(r.RunId))">
                            <td @onclick:stopPropagation="true">
                                <MudCheckBox T="bool" Value="@sel"
                                             ValueChanged="@(_ => ToggleRunSelection(r.RunId))"
                                             Size="Size.Small" />
                            </td>
                            <td style="white-space:nowrap;">
                                <MudText Typo="Typo.caption">@r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm")</MudText>
                            </td>
                            <td class="col-flex"><strong>@r.PlanName</strong></td>
                            <td>
                                @foreach (string ek in r.EnvironmentKeys)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-1">@ek</MudChip>
                                }
                            </td>
                            <td style="text-align:right;">
                                <span style="font-size:1.15em;font-weight:700;color:var(--mud-palette-success);">
                                    @r.BenchScore.ToString("N0")
                                </span>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">pts</MudText>
                            </td>
                            <td style="text-align:right;">@r.SuccessRatePct.ToString("F1")%</td>
                            <td>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(r.FinalStatus == TestRunStatus.Completed ? Color.Success : Color.Default)"
                                         Variant="Variant.Filled">@r.FinalStatus</MudChip>
                            </td>
                            <td style="text-align:right;" @onclick:stopPropagation="true">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           OnClick="@(() => DownloadReport(r.RunId))">Download</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            @* Compare button *@
            @if (_selectedRunIds.Count >= 2)
            {
                <div class="d-flex align-center mb-4" style="gap:12px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Compare"
                               OnClick="@(() => _comparing = !_comparing)">
                        @(_comparing ? "Hide comparison" : $"Compare {_selectedRunIds.Count} runs")
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="@(() => _selectedRunIds.Clear())">Clear selection</MudButton>
                </div>
            }

            @* Side-by-side comparison *@
            @if (_comparing && _selectedRunIds.Count >= 2)
            {
                var selected = _reports.Where(r => _selectedRunIds.Contains(r.RunId)).ToList();
                int bestScore = selected.Max(r => r.BenchScore);

                <MudPaper Elevation="2" Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Benchmark comparison</MudText>

                    @* Score cards - prominent like a benchmarking tool *@
                    <div class="d-flex flex-wrap mb-4" style="gap:16px;">
                        @foreach (TestRunReport r in selected)
                        {
                            bool winner = r.BenchScore == bestScore && selected.Count(x => x.BenchScore == bestScore) == 1;
                            <MudPaper Elevation="1" Class="pa-3 flex-grow-1"
                                      Style="@($"border:2px solid {(winner ? "var(--mud-palette-success)" : "var(--mud-palette-lines-default)")}; text-align:center; min-width:140px;")">
                                @if (winner)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="mb-1">Winner</MudChip>
                                }
                                <div style="font-size:2rem;font-weight:800;color:var(--mud-palette-@(winner ? "success" : "text-primary"));">
                                    @r.BenchScore.ToString("N0")
                                </div>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">pts</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1"><strong>@r.PlanName</strong></MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm")</MudText>
                            </MudPaper>
                        }
                    </div>

                    @* Metrics table *@
                    <div style="overflow-x:auto;">
                        <table class="mud-table mud-table-hover" style="width:100%;border-collapse:collapse;">
                            <thead>
                                <tr style="border-bottom:1px solid var(--mud-palette-lines-default);">
                                    <th style="text-align:left;padding:8px 12px;width:180px;">Metric</th>
                                    @foreach (TestRunReport r in selected)
                                    {
                                        bool winner = r.BenchScore == bestScore && selected.Count(x => x.BenchScore == bestScore) == 1;
                                        <th style="text-align:right;padding:8px 12px;@(winner ? "color:var(--mud-palette-success);" : "")">
                                            @r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm")
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @CompareRow("BenchScore (pts)", selected, r => r.BenchScore.ToString("N0"), r => (double)r.BenchScore, highIsGood: true, bold: true)
                                @CompareRow("Throughput (m/min)", selected, r => r.ThroughputPerMin.ToString("F1"), r => r.ThroughputPerMin, highIsGood: true)
                                @CompareRow("Success rate", selected, r => r.SuccessRatePct.ToString("F2") + "%", r => r.SuccessRatePct, highIsGood: true)
                                @CompareRow("P95 latency (ms)", selected, r => r.P95PushDurationMs.ToString("F0"), r => r.P95PushDurationMs, highIsGood: false)
                                @CompareRow("Median latency (ms)", selected, r => r.MedianPushDurationMs.ToString("F0"), r => r.MedianPushDurationMs, highIsGood: false)
                                @CompareRow("Total pushed", selected, r => r.TotalMetersPushed.ToString("N0"), r => (double)r.TotalMetersPushed, highIsGood: true)
                                @CompareRow("Failed", selected, r => r.TotalMetersFailed.ToString("N0"), r => (double)r.TotalMetersFailed, highIsGood: false)
                                @CompareRow("Ticks completed", selected, r => r.TotalTicks.ToString(), r => (double)r.TotalTicks, highIsGood: true)
                            </tbody>
                        </table>
                    </div>

                    @* Per-environment breakdown if any run has multiple envs *@
                    @{
                        var allEnvKeys = selected
                            .SelectMany(r => r.Environments.Select(e => e.EnvironmentKey))
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .ToList();
                    }
                    @if (allEnvKeys.Count > 1 || (allEnvKeys.Count == 1 && selected.Any(r => r.Environments.Count > 0)))
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Per-environment BenchScore</MudText>
                        <div style="overflow-x:auto;">
                            <table class="mud-table" style="width:100%;border-collapse:collapse;">
                                <thead>
                                    <tr style="border-bottom:1px solid var(--mud-palette-lines-default);">
                                        <th style="text-align:left;padding:8px 12px;">Environment</th>
                                        @foreach (TestRunReport r in selected)
                                        {
                                            <th style="text-align:right;padding:8px 12px;">@r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm")</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (string envKey in allEnvKeys)
                                    {
                                        <tr style="border-bottom:1px solid var(--mud-palette-lines-default);">
                                            <td style="padding:8px 12px;"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@envKey</MudChip></td>
                                            @foreach (TestRunReport r in selected)
                                            {
                                                var env = r.Environments.FirstOrDefault(e => string.Equals(e.EnvironmentKey, envKey, StringComparison.OrdinalIgnoreCase));
                                                <td style="text-align:right;padding:8px 12px;">
                                                    @if (env is not null)
                                                    {
                                                        <strong>@env.BenchScore.ToString("N0")</strong>
                                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@env.SuccessRatePct.ToString("F1")% success</MudText>
                                                    }
                                                    else
                                                    {
                                                        <span class="mud-text-secondary">--</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </MudPaper>
            }
        }
    </MudTabPanel>
</MudTabs>

@* ---------- Configure loop push dialog ---------- *@
<MudDialog @bind-Visible="_loopDialogOpen" Options="_loopDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Configure loop push</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Pushes the selected batches on a repeating timer, starting immediately.
        </MudText>
        <MudSelect T="int" @bind-SelectedValues="_loopBatchIds" Label="Batches" MultiSelection="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4">
            @foreach (MeterBatch b in _batches)
            {
                <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType), @b.Count.ToString("N0") meters)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="int" @bind-Value="_loopIntervalMinutes" Label="Every"
                   Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (int minutes in PushScheduleService.AllowedIntervalMinutes)
            {
                <MudSelectItem T="int" Value="@minutes">@minutes min</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _loopDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(!_loopBatchIds.Any())" OnClick="StartLoop">
            Start loop
        </MudButton>
    </DialogActions>
</MudDialog>

@* ---------- Add / Edit plan dialog ---------- *@
<MudDialog @bind-Visible="_planDialogOpen" Options="_planDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingPlan ? "Edit plan" : "New test plan")</MudText>
    </TitleContent>
    <DialogContent>
        @* Selects at top so their dropdown opens downward into content, not toward the footer *@
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="string" @bind-SelectedValues="_planEnvKeys" Label="Environments (empty = all)"
                           MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var env in Network.Environments)
                    {
                        <MudSelectItem T="string" Value="@env.Key">@env.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int" @bind-SelectedValues="_planBatchIds" Label="Batches"
                           MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (MeterBatch b in _batches)
                    {
                        <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType), @b.Count.ToString("N0") meters)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_planName" Label="Name" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@_editingBasePlan" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_planPushIntervalSec" Label="Push interval (sec)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="60" Max="3600"
                                 Disabled="@_planPushIntervalLocked" />
                @if (_planPushIntervalLocked)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Locked on base plan</MudText>
                }
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="int" @bind-Value="_planDurationMin" Label="Duration (min)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="240"
                                 Disabled="@_planDurationLocked" />
                @if (_planDurationLocked)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Locked on base plan</MudText>
                }
            </MudItem>
        </MudGrid>

        @if (_planError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-3">@_planError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _planDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePlan">Save</MudButton>
    </DialogActions>
</MudDialog>

@* ---------- Run plan dialog ---------- *@
<MudDialog @bind-Visible="_runDialogOpen" Options="_runDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Run &mdash; @(_runPlan?.DisplayName)</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Pushes every @(_runPlan?.PushIntervalSec ?? 300)s for @(_runPlan?.CollectionDurationMin ?? 15) min.
            Immediate push buttons are disabled while the run is active.
        </MudText>

        @if (_runBatchIds.Count == 0 && _runPlan is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                No batches configured. Add batches via Edit first.
            </MudAlert>
        }

        <MudSelect T="int" @bind-SelectedValues="_runBatchIds" Label="Batches to push"
                   MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4">
            @foreach (MeterBatch b in _batches)
            {
                <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType), @b.Count.ToString("N0") meters)</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="int" @bind-Value="_runDelayMinutes" Label="Start delay (minutes)"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="120" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">0 = start immediately.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _runDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success"
                   Disabled="@(!_runBatchIds.Any())"
                   OnClick="StartRun">Start</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<MeterBatch> _batches = Array.Empty<MeterBatch>();
    private IReadOnlyList<TestPlan> _plans = Array.Empty<TestPlan>();
    private IReadOnlyList<TestRunReport> _reports = Array.Empty<TestRunReport>();
    private readonly HashSet<int> _pushingBatchIds = new();
    private System.Threading.Timer? _timer;
    private bool _testRunActive;
    private TestRunState? _activeRun;

    private PushScheduleState _scheduleState = PushScheduleState.Idle;

    // Loop push dialog
    private bool _loopDialogOpen;
    private readonly DialogOptions _loopDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private IReadOnlyCollection<int> _loopBatchIds = Array.Empty<int>();
    private int _loopIntervalMinutes = PushScheduleService.AllowedIntervalMinutes[0];

    // Run dialog
    private bool _runDialogOpen;
    private readonly DialogOptions _runDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private TestPlan? _runPlan;
    private IReadOnlyCollection<int> _runBatchIds = Array.Empty<int>();
    private int _runDelayMinutes;

    // Plan dialog
    private bool _planDialogOpen;
    private readonly DialogOptions _planDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool _editingPlan;
    private bool _editingBasePlan;
    private string? _planId;
    private string _planName = "";
    private int _planPushIntervalSec = 300;
    private int _planDurationMin = 15;
    private IReadOnlyCollection<string> _planEnvKeys = Array.Empty<string>();
    private IReadOnlyCollection<int> _planBatchIds = Array.Empty<int>();
    private bool _planPushIntervalLocked;
    private bool _planDurationLocked;
    private string? _planError;

    // Results / comparison
    private readonly HashSet<string> _selectedRunIds = new();
    private bool _comparing;

    private const long MaxConfigBytes = 4 * 1024 * 1024;

    protected override void OnInitialized()
    {
        Refresh();
        Schedule.Changed += OnScheduleChanged;
        TestPlans.Changed += OnPlansChanged;
        RunEngine.Changed += OnRunChanged;
        RunEngine.RunCompleted += OnRunCompleted;
        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }), null, 2000, 2000);
    }

    private void Refresh()
    {
        _batches = MeterRegistry.Batches;
        _scheduleState = Schedule.State;
        _plans = TestPlans.Plans;
        _activeRun = RunEngine.ActiveRun;
        _testRunActive = RunEngine.IsActive;
        _reports = RunStore.LoadAll();
    }

    private void OnScheduleChanged() => InvokeAsync(() => { _scheduleState = Schedule.State; StateHasChanged(); });
    private void OnPlansChanged() => InvokeAsync(() => { _plans = TestPlans.Plans; StateHasChanged(); });
    private void OnRunChanged() => InvokeAsync(() =>
    {
        _activeRun = RunEngine.ActiveRun;
        _testRunActive = RunEngine.IsActive;
        StateHasChanged();
    });
    private void OnRunCompleted(TestRunReport report) => InvokeAsync(async () =>
    {
        _activeRun = RunEngine.ActiveRun;
        _testRunActive = false;
        _reports = RunStore.LoadAll();
        StateHasChanged();
        Snackbar.Add($"Run complete &mdash; BenchScore {report.BenchScore:N0}. Downloading report...", Severity.Success);
        await JS.InvokeVoidAsync("mayaDownload", $"/reports/{report.RunId}.json");
    });

    // On-demand push

    private async Task SendPushAsync(int batchId)
    {
        _pushingBatchIds.Add(batchId);
        try
        {
            PushBatchResult result = await Push.PushBatchAsync(batchId);
            if (!result.Ok)
                Snackbar.Add(result.Error ?? "Push failed.", Severity.Error);
            else if (result.Failed == 0)
                Snackbar.Add($"Pushed {result.Sent} of {result.Total} meter(s).", Severity.Success);
            else
                Snackbar.Add($"Pushed {result.Sent}/{result.Total}; {result.Failed} failed.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Push error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _pushingBatchIds.Remove(batchId);
        }
    }

    // Loop push

    private void OpenLoopDialog()
    {
        _loopBatchIds = _scheduleState.BatchIds.ToList();
        _loopIntervalMinutes = _scheduleState.IntervalMinutes > 0
            ? _scheduleState.IntervalMinutes
            : PushScheduleService.AllowedIntervalMinutes[0];
        _loopDialogOpen = true;
    }

    private void StartLoop()
    {
        try
        {
            Schedule.Start(_loopBatchIds.ToList(), _loopIntervalMinutes);
            _loopDialogOpen = false;
            Snackbar.Add($"Loop push started - every {_loopIntervalMinutes} min.", Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void StopLoop()
    {
        Schedule.Stop();
        Snackbar.Add("Loop push stopped.", Severity.Info);
    }

    // Test run

    private void OpenRunDialog(TestPlan plan)
    {
        _runPlan = plan;
        _runBatchIds = plan.BatchIds.Where(id => _batches.Any(b => b.Id == id)).ToList();
        _runDelayMinutes = 0;
        _runDialogOpen = true;
    }

    private void StartRun()
    {
        if (_runPlan is null || !_runBatchIds.Any()) return;

        DateTimeOffset startAt = _runDelayMinutes > 0
            ? DateTimeOffset.UtcNow.AddMinutes(_runDelayMinutes)
            : DateTimeOffset.UtcNow;

        try
        {
            RunEngine.ScheduleRun(_runPlan, _runBatchIds.ToList(), startAt);
            _runDialogOpen = false;
            Snackbar.Add(_runDelayMinutes > 0
                ? $"Run scheduled to start in {_runDelayMinutes} min."
                : "Run started.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void CancelRun()
    {
        RunEngine.Cancel();
        Snackbar.Add("Run cancelled.", Severity.Warning);
    }

    // Test plans

    private void OpenAddPlan()
    {
        _editingPlan = false;
        _editingBasePlan = false;
        _planId = null;
        _planName = "";
        _planPushIntervalSec = 300;
        _planDurationMin = 15;
        _planEnvKeys = Array.Empty<string>();
        _planBatchIds = Array.Empty<int>();
        _planPushIntervalLocked = false;
        _planDurationLocked = false;
        _planError = null;
        _planDialogOpen = true;
    }

    private void OpenEditPlan(TestPlan plan)
    {
        _editingPlan = true;
        _editingBasePlan = plan.IsBasePlan;
        _planId = plan.Id;
        _planName = plan.Name;
        _planPushIntervalSec = plan.PushIntervalSec;
        _planDurationMin = plan.CollectionDurationMin;
        _planEnvKeys = plan.EnvironmentKeys.ToList();
        _planBatchIds = plan.BatchIds.ToList();
        _planPushIntervalLocked = plan.IsFieldLocked(nameof(TestPlan.PushIntervalSec));
        _planDurationLocked = plan.IsFieldLocked(nameof(TestPlan.CollectionDurationMin));
        _planError = null;
        _planDialogOpen = true;
    }

    private void SavePlan()
    {
        _planError = null;

        if (string.IsNullOrWhiteSpace(_planName) && !_editingBasePlan)
        {
            _planError = "Name is required.";
            return;
        }

        try
        {
            if (_editingPlan && _planId is not null)
            {
                TestPlan? existing = TestPlans.Plan(_planId);
                if (existing is null) { _planError = "Plan not found."; return; }

                var updated = new TestPlan
                {
                    Id = existing.Id,
                    Name = _editingBasePlan ? existing.Name : _planName,
                    IsBasePlan = existing.IsBasePlan,
                    PushIntervalSec = _planPushIntervalSec,
                    CollectionDurationMin = _planDurationMin,
                    EnvironmentKeys = _planEnvKeys.ToList(),
                    BatchIds = _planBatchIds.ToList(),
                    LockedFields = existing.LockedFields,
                };
                TestPlans.UpdatePlan(updated);
            }
            else
            {
                TestPlans.AddPlan(new TestPlan
                {
                    Name = _planName,
                    PushIntervalSec = _planPushIntervalSec,
                    CollectionDurationMin = _planDurationMin,
                    EnvironmentKeys = _planEnvKeys.ToList(),
                    BatchIds = _planBatchIds.ToList(),
                });
            }

            _planDialogOpen = false;
            Snackbar.Add("Plan saved.", Severity.Success);
        }
        catch (ArgumentException ex)
        {
            _planError = ex.Message;
        }
    }

    private void DeletePlan(TestPlan plan)
    {
        if (!TestPlans.DeletePlan(plan.Id, out string error))
            Snackbar.Add(error, Severity.Error);
    }

    // Results

    private void ToggleRunSelection(string runId)
    {
        if (!_selectedRunIds.Remove(runId))
            _selectedRunIds.Add(runId);
        if (_selectedRunIds.Count < 2)
            _comparing = false;
    }

    private async Task DownloadReport(string runId) =>
        await JS.InvokeVoidAsync("mayaDownload", $"/reports/{runId}.json");

    private RenderFragment CompareRow(
        string label,
        List<TestRunReport> runs,
        Func<TestRunReport, string> fmt,
        Func<TestRunReport, double> val,
        bool highIsGood,
        bool bold = false) => builder =>
    {
        double best = highIsGood ? runs.Max(val) : runs.Min(val);
        builder.OpenElement(0, "tr");
        builder.AddAttribute(1, "style", "border-bottom:1px solid var(--mud-palette-lines-default);");

        builder.OpenElement(2, "td");
        builder.AddAttribute(3, "style", "padding:8px 12px;");
        if (bold)
        {
            builder.OpenElement(4, "strong");
            builder.AddContent(5, label);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(6, label);
        }
        builder.CloseElement();

        int seq = 10;
        foreach (var r in runs)
        {
            double v = val(r);
            bool isBest = Math.Abs(v - best) < 0.0001;
            string color = isBest && runs.Count(x => Math.Abs(val(x) - best) < 0.0001) == 1
                ? "var(--mud-palette-success)"
                : "inherit";

            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "style", $"text-align:right;padding:8px 12px;color:{color};{(bold ? "font-weight:700;font-size:1.05em;" : "")}");
            builder.AddContent(seq++, fmt(r));
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    // Config import / export

    private async Task ExportTesting() => await JS.InvokeVoidAsync("mayaDownload", "/config/testing.json");

    private async Task OnTestingFileSelected(InputFileChangeEventArgs e)
    {
        IBrowserFile? file = e.FileCount > 0 ? e.File : null;
        if (file is null) return;

        string json;
        try
        {
            await using Stream stream = file.OpenReadStream(MaxConfigBytes);
            using var reader = new StreamReader(stream);
            json = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not read the file: {ex.Message}", Severity.Error);
            return;
        }

        TestingFile preview;
        try { preview = ConfigBundles.PreviewTesting(json); }
        catch (ArgumentException ex) { Snackbar.Add(ex.Message, Severity.Error); return; }

        try
        {
            TestingImportResult applied = ConfigBundles.ImportTesting(json);
            string missing = applied.Missing.Count > 0
                ? $" ({applied.Missing.Count} not found here: {string.Join(", ", applied.Missing)})"
                : string.Empty;
            Snackbar.Add(
                $"Loop push started - {applied.Resolved} batch(es) every {preview.IntervalMinutes} min.{missing}",
                applied.Missing.Count > 0 ? Severity.Warning : Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // Presentation helpers

    private static string RelativeTime(DateTimeOffset? when)
    {
        if (when is null) return "--";
        TimeSpan delta = when.Value - DateTimeOffset.UtcNow;
        return delta.TotalSeconds switch
        {
            > 0 and < 60 => $"in {delta.TotalSeconds:F0}s",
            > 0 => $"in {delta.TotalMinutes:F0}m",
            _ => delta.TotalSeconds switch
            {
                > -60 => $"{-delta.TotalSeconds:F0}s ago",
                _ => $"{-delta.TotalMinutes:F0}m ago",
            },
        };
    }

    private static string RunStatusColor(TestRunStatus s) => s switch
    {
        TestRunStatus.Running => "success",
        TestRunStatus.Scheduled => "info",
        TestRunStatus.Completed => "success",
        TestRunStatus.Cancelled => "default",
        TestRunStatus.Failed => "error",
        _ => "default",
    };

    private static Color RunStatusMudColor(TestRunStatus s) => s switch
    {
        TestRunStatus.Running => Color.Success,
        TestRunStatus.Scheduled => Color.Info,
        TestRunStatus.Completed => Color.Success,
        TestRunStatus.Failed => Color.Error,
        _ => Color.Default,
    };

    private static Color StatusColor(BatchStatus status) => status switch
    {
        BatchStatus.Running => Color.Success,
        BatchStatus.Starting => Color.Info,
        BatchStatus.Stopped => Color.Error,
        _ => Color.Default,
    };

    private static string StatusRowClass(BatchStatus status) => status switch
    {
        BatchStatus.Running => "is-running",
        BatchStatus.Starting => "is-starting",
        BatchStatus.Stopped => "is-stopped",
        _ => "is-idle",
    };

    private static string NicLabel(NicType nic) => nic switch
    {
        NicType.Tcp4G => "4G TCP",
        NicType.Mqtt4G => "4G MQTT",
        NicType.Mqtt4GImg => "4G IMG MQTT",
        NicType.MqttWirepas => "RF Wirepas",
        NicType.MqttKmesh => "RF Kimbal Mesh",
        _ => nic.ToString(),
    };

    public void Dispose()
    {
        Schedule.Changed -= OnScheduleChanged;
        TestPlans.Changed -= OnPlansChanged;
        RunEngine.Changed -= OnRunChanged;
        RunEngine.RunCompleted -= OnRunCompleted;
        _timer?.Dispose();
    }
}

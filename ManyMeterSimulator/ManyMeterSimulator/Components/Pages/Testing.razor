@page "/testing"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ManyMeterSimulator.Brain
@using ManyMeterSimulator.Networking.Nic
@using ManyMeterSimulator.Networking.Registry
@using ManyMeterSimulator.Provisioning
@using ManyMeterSimulator.Testing
@inject MeterRegistry MeterRegistry
@inject NetworkRegistry Network
@inject PushCoordinator Push
@inject PushScheduleService Schedule
@inject ConfigBundleService ConfigBundles
@inject TestPlanRegistry TestPlans
@inject TestRunEngine RunEngine
@inject TestRunStore RunStore
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>MAYA - Testing</PageTitle>

<style>
    @@keyframes spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
    @@keyframes shimmer { 0%{background-position:-200% 0} 100%{background-position:200% 0} }
    @@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

    /* ── Layout guards: MudBlazor tab panels don't constrain width by default ── */
    .mud-tabs-panels, .mud-tab-panel { min-width:0 !important; max-width:100% !important; }
    .tab-content { width:100%; max-width:100%; min-width:0; overflow-x:hidden; box-sizing:border-box; padding:24px 2px 8px; }
    .tab-content * { box-sizing:border-box; }
    .mud-tabs-toolbar { margin-bottom:4px; }

    /* ── Section heading ── */
    .sec-head { display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap; margin:0 0 14px; }
    .sec-title { font-size:.95rem; font-weight:700; letter-spacing:-.01em; }
    .sec-sub { font-size:.76rem; color:var(--mud-palette-text-secondary); }
    .sec-gap { margin-top:28px; }

    .wf-card { border:1px solid var(--mud-palette-lines-default); border-radius:8px; overflow:hidden; max-width:100%; width:100%; box-sizing:border-box; }
    .wf-header { padding:13px 16px; background:var(--mud-palette-background-grey); border-bottom:1px solid var(--mud-palette-lines-default); display:flex; align-items:center; gap:12px; flex-wrap:wrap; min-width:0; overflow:hidden; }
    .wf-title { font-weight:600; font-size:.9rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .wf-actions { display:flex; gap:6px; flex-shrink:0; flex-wrap:wrap; justify-content:flex-end; }
    .wf-meta { font-size:.75rem; color:var(--mud-palette-text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

    .job-row { padding:10px 14px; border-top:1px solid var(--mud-palette-lines-default); display:flex; align-items:flex-start; gap:10px; position:relative; min-width:0; overflow:hidden; }
    .job-row.running { background:color-mix(in srgb,var(--mud-palette-primary) 4%,transparent); }
    .job-row:first-child { border-top:none; }

    .job-icon { width:20px; height:20px; flex-shrink:0; display:flex; align-items:center; justify-content:center; margin-top:2px; }
    .icon-spin { width:16px; height:16px; border:2.5px solid color-mix(in srgb,var(--mud-palette-primary) 25%,transparent); border-top-color:var(--mud-palette-primary); border-radius:50%; animation:spin .75s linear infinite; }
    .icon-ring { width:14px; height:14px; border:2px solid var(--mud-palette-lines-default); border-radius:50%; }
    .icon-ok { width:16px; height:16px; border-radius:50%; background:var(--mud-palette-success); display:flex; align-items:center; justify-content:center; }
    .icon-ok::after { content:''; width:4px; height:7px; border:2px solid #fff; border-top:none; border-left:none; transform:rotate(45deg) translate(-1px,-1px); }

    .job-body { flex:1; min-width:0; overflow:hidden; }
    .job-name { font-size:.84rem; font-weight:600; display:flex; align-items:center; gap:7px; flex-wrap:wrap; min-width:0; }
    .job-sub { font-size:.72rem; color:var(--mud-palette-text-secondary); margin-top:3px; font-family:ui-monospace,monospace; overflow-wrap:break-word; word-break:break-word; }

    .job-track { margin-top:7px; height:3px; background:var(--mud-palette-lines-default); border-radius:2px; overflow:hidden; }
    .job-fill { height:100%; border-radius:2px; transition:width .8s ease; }
    .job-fill.running { background:linear-gradient(90deg,var(--mud-palette-primary) 0%,color-mix(in srgb,var(--mud-palette-primary) 50%,white) 50%,var(--mud-palette-primary) 100%); background-size:200% 100%; animation:shimmer 1.6s linear infinite; }
    .job-fill.done { background:var(--mud-palette-success); }
    .job-fill.stopped { background:var(--mud-palette-error); opacity:.75; }
    .icon-stop { width:14px; height:14px; border-radius:3px; background:var(--mud-palette-error); opacity:.85; }

    .job-dur { font-size:.72rem; color:var(--mud-palette-text-secondary); font-family:ui-monospace,monospace; white-space:nowrap; flex-shrink:0; padding-left:8px; }

    .tbadge { display:inline-flex; align-items:center; padding:1px 7px; border-radius:4px; font-size:.65rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; }
    .tbadge-push { background:color-mix(in srgb,var(--mud-palette-primary) 15%,transparent); color:var(--mud-palette-primary); }
    .tbadge-pull { background:color-mix(in srgb,var(--mud-palette-secondary) 15%,transparent); color:var(--mud-palette-secondary); }
    .tbadge-burst { background:color-mix(in srgb,var(--mud-palette-warning) 20%,transparent); color:color-mix(in srgb,var(--mud-palette-warning) 80%,black); }

    .add-job { padding:10px 16px; border-top:1px solid var(--mud-palette-lines-default); display:flex; align-items:center; gap:7px; font-size:.8rem; color:var(--mud-palette-primary); cursor:pointer; user-select:none; }
    .add-job:hover { background:color-mix(in srgb,var(--mud-palette-primary) 5%,transparent); }

    .metrics-strip { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:1px; background:var(--mud-palette-lines-default); border:1px solid var(--mud-palette-lines-default); border-radius:8px; overflow:hidden; margin-bottom:16px; }
    .metric-cell { min-width:0; padding:13px 14px; background:var(--mud-palette-surface); }
    .metric-val { min-width:0; overflow-wrap:anywhere; font-size:clamp(1rem,2vw,1.35rem); font-weight:800; font-family:ui-monospace,monospace; line-height:1.2; }
    .metric-key { overflow-wrap:anywhere; font-size:.65rem; text-transform:uppercase; letter-spacing:.06em; color:var(--mud-palette-text-secondary); margin-top:2px; }

    .result-row { padding:10px 14px; border-bottom:1px solid var(--mud-palette-lines-default); display:flex; align-items:center; gap:10px; cursor:pointer; transition:background .12s; min-width:0; width:100%; box-sizing:border-box; border-left:3px solid transparent; }
    .result-row:last-child { border-bottom:none; }
    .result-row:hover { background:var(--mud-palette-background-grey); }
    .result-row.sel { background:color-mix(in srgb,var(--mud-palette-primary) 6%,transparent); border-left-color:var(--mud-palette-primary); }
    .result-check { width:14px; flex-shrink:0; font-size:.75rem; color:var(--mud-palette-primary); font-weight:800; line-height:1; }
    .result-info { flex:1 1 auto; min-width:0; overflow:hidden; }
    .result-name { font-size:.84rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .result-meta { font-size:.7rem; color:var(--mud-palette-text-secondary); display:flex; align-items:center; gap:5px; flex-wrap:wrap; margin-top:2px; }
    /* fixed-width score columns keep every row's numbers on the same vertical line */
    .result-scores { display:flex; gap:18px; flex:0 0 auto; align-items:center; margin-right:30px; }
    .result-score { width:66px; text-align:right; }
    .result-actions { display:flex; align-items:center; flex:0 0 42px; justify-content:center; }
    .result-score-val { font-family:ui-monospace,monospace; font-weight:700; font-size:.88rem; line-height:1.2; }
    /* column headers live once at the top, not repeated on every row */
    .result-head { display:flex; align-items:center; gap:10px; padding:8px 14px; border-bottom:1px solid var(--mud-palette-lines-default); border-left:3px solid transparent; background:var(--mud-palette-background-grey); font-size:.62rem; text-transform:uppercase; letter-spacing:.07em; font-weight:700; color:var(--mud-palette-text-secondary); }
    .result-head .result-check { visibility:hidden; }
    .result-status { flex:0 0 78px; text-align:center; font-size:.68rem; padding:2px 8px; border-radius:4px; font-weight:600; white-space:nowrap; }
    /* drop the least important columns first rather than clipping */
    @@media (max-width:860px) { .result-status { display:none; } }
    @@media (max-width:700px) { .result-score.opt { display:none; } }

    .lb-row { display:flex; align-items:center; gap:12px; padding:10px 16px; border-bottom:1px solid var(--mud-palette-lines-default); border-left:3px solid transparent; cursor:pointer; transition:background .12s; }
    .lb-row:last-child { border-bottom:none; }
    .lb-row:hover { background:var(--mud-palette-background-grey); }
    .lb-row.sel { background:color-mix(in srgb,var(--mud-palette-primary) 6%,transparent); border-left-color:var(--mud-palette-primary); }
    .lb-rank { font-family:ui-monospace,monospace; font-weight:800; font-size:.85rem; width:28px; flex-shrink:0; color:var(--mud-palette-text-secondary); }
    .lb-rank.gold { color:#f5c842; }
    .lb-rank.silver { color:#aab4c0; }
    .lb-rank.bronze { color:#cd8a5c; }
    .lb-bar-wrap { flex:1; min-width:60px; }
    .lb-bar { height:4px; border-radius:2px; background:var(--mud-palette-primary); opacity:.6; }
    .lb-bar.gold { opacity:1; }

    .view-toggle { display:flex; gap:0; border:1px solid var(--mud-palette-lines-default); border-radius:6px; overflow:hidden; margin-bottom:16px; width:fit-content; }
    .view-toggle-btn { padding:6px 16px; font-size:.78rem; font-weight:600; cursor:pointer; user-select:none; border:none; background:transparent; color:var(--mud-palette-text-secondary); transition:background .12s,color .12s; }
    .view-toggle-btn.active { background:var(--mud-palette-primary); color:#fff; }
    .view-toggle-btn + .view-toggle-btn { border-left:1px solid var(--mud-palette-lines-default); }

    .score-big { font-size:2.2rem; font-weight:800; font-family:ui-monospace,monospace; line-height:1; }
    .score-norm { font-size:.95rem; font-weight:600; font-family:ui-monospace,monospace; color:var(--mud-palette-text-secondary); }

    /* ── Comparison: ONE grid template shared by header + every row so columns line up ── */
    /* with 3+ runs the table can exceed the viewport — it scrolls itself, page never does */
    .cmp-scroll { overflow-x:auto; max-width:100%; padding-bottom:2px; }
    .cmp-table { border:1px solid var(--mud-palette-lines-default); border-radius:8px; overflow:hidden; width:100%; }
    .cmp-grid { display:grid; grid-template-columns:minmax(120px,1.1fr) minmax(0,1fr) minmax(0,1fr); align-items:stretch; }
    .cmp-grid > * { min-width:0; overflow:hidden; }

    .cmp-head-row { background:var(--mud-palette-background-grey); border-bottom:1px solid var(--mud-palette-lines-default); }
    .cmp-corner { padding:14px 16px; border-right:1px solid var(--mud-palette-lines-default); display:flex; align-items:flex-end; font-size:.66rem; text-transform:uppercase; letter-spacing:.07em; font-weight:700; color:var(--mud-palette-text-secondary); }
    .cmp-head-cell { padding:14px 16px; border-right:1px solid var(--mud-palette-lines-default); }
    .cmp-head-cell:last-child { border-right:none; }
    .cmp-head-name { font-size:.8rem; font-weight:700; display:flex; align-items:center; gap:7px; flex-wrap:wrap; overflow-wrap:anywhere; }
    .cmp-head-meta { font-size:.68rem; color:var(--mud-palette-text-secondary); margin-top:3px; overflow-wrap:anywhere; }
    .cmp-head-score { margin-top:10px; display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }

    .cmp-row { border-bottom:1px solid var(--mud-palette-lines-default); }
    .cmp-row:last-child { border-bottom:none; }
    .cmp-row:hover { background:color-mix(in srgb,var(--mud-palette-text-primary) 3%,transparent); }
    .cmp-label { padding:10px 16px; font-size:.76rem; color:var(--mud-palette-text-secondary); border-right:1px solid var(--mud-palette-lines-default); display:flex; align-items:center; overflow-wrap:anywhere; }
    .cmp-cell { padding:10px 16px; font-family:ui-monospace,monospace; font-size:.85rem; border-right:1px solid var(--mud-palette-lines-default); display:flex; align-items:center; overflow-wrap:anywhere; }
    .cmp-cell:last-child { border-right:none; }
    .cmp-cell.best { color:var(--mud-palette-success); font-weight:700; }
    .cmp-section { grid-column:1 / -1; padding:7px 16px; font-size:.66rem; text-transform:uppercase; letter-spacing:.07em; font-weight:700; color:var(--mud-palette-text-secondary); background:var(--mud-palette-background-grey); border-top:1px solid var(--mud-palette-lines-default); border-bottom:1px solid var(--mud-palette-lines-default); }
    .cmp-section.cmp-pull { color:var(--mud-palette-secondary); background:color-mix(in srgb,var(--mud-palette-secondary) 11%,var(--mud-palette-surface)); border-left:3px solid var(--mud-palette-secondary); }
    .cmp-section.cmp-push { color:var(--mud-palette-primary); background:color-mix(in srgb,var(--mud-palette-primary) 11%,var(--mud-palette-surface)); border-left:3px solid var(--mud-palette-primary); }
    .cmp-section.cmp-debug { color:var(--mud-palette-text-secondary); background:color-mix(in srgb,var(--mud-palette-text-secondary) 8%,var(--mud-palette-surface)); border-left:3px solid var(--mud-palette-text-secondary); }

    .env-chip { display:inline-flex; align-items:center; padding:2px 8px; border-radius:4px; font-size:.7rem; border:1px solid var(--mud-palette-lines-default); margin-right:4px; cursor:pointer; user-select:none; transition:background .12s; }
    .env-chip.active { background:color-mix(in srgb,var(--mud-palette-primary) 12%,transparent); border-color:var(--mud-palette-primary); color:var(--mud-palette-primary); font-weight:600; }

    .mono { font-family:ui-monospace,monospace; }
    .cancel-btn-sm { display:inline-flex; align-items:center; justify-content:center; padding:4px 12px; border-radius:5px; border:1px solid var(--mud-palette-error); color:var(--mud-palette-error); font-size:.78rem; font-weight:600; cursor:pointer; background:transparent; transition:background .12s; }
    .cancel-btn-sm:hover { background:color-mix(in srgb,var(--mud-palette-error) 8%,transparent); }

    /* ── Run status pill + progress bar: bar & pill share a color so they read as one unit ── */
    .run-status { display:inline-flex; align-items:center; gap:6px; padding:3px 10px; border-radius:11px; font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; white-space:nowrap; }
    .run-status .dot { width:7px; height:7px; border-radius:50%; background:currentColor; }
    .run-status.running { color:var(--mud-palette-primary); background:color-mix(in srgb,var(--mud-palette-primary) 12%,transparent); }
    .run-status.running .dot { animation:pulse 1.2s ease-in-out infinite; }
    .run-status.scheduled { color:var(--mud-palette-text-secondary); background:color-mix(in srgb,var(--mud-palette-text-secondary) 12%,transparent); }
    .run-status.completed { color:var(--mud-palette-success); background:color-mix(in srgb,var(--mud-palette-success) 14%,transparent); }
    .run-status.cancelled, .run-status.failed { color:var(--mud-palette-error); background:color-mix(in srgb,var(--mud-palette-error) 12%,transparent); }

    .run-bar-wrap { min-width:140px; max-width:220px; flex:1; }
    .run-bar { height:6px; background:var(--mud-palette-lines-default); border-radius:3px; overflow:hidden; position:relative; }
    .run-bar-fill { height:100%; border-radius:3px; transition:width .8s ease; }
    .run-bar-fill.running { background:linear-gradient(90deg,var(--mud-palette-primary) 0%,color-mix(in srgb,var(--mud-palette-primary) 40%,white) 50%,var(--mud-palette-primary) 100%); background-size:200% 100%; animation:shimmer 1.6s linear infinite; }
    .run-bar-fill.scheduled { background:var(--mud-palette-text-secondary); opacity:.35; }
    .run-bar-fill.completed { background:var(--mud-palette-success); }
    .run-bar-fill.cancelled, .run-bar-fill.failed { background:var(--mud-palette-error); opacity:.75; }
    .run-bar-pct { display:flex; justify-content:space-between; font-size:.62rem; font-family:ui-monospace,monospace; color:var(--mud-palette-text-secondary); margin-top:3px; }

    @@media (max-width:700px) {
        .cmp-grid { grid-template-columns:minmax(90px,1fr) minmax(0,1fr) minmax(0,1fr); }
        .cmp-label, .cmp-cell, .cmp-corner, .cmp-head-cell { padding-left:10px; padding-right:10px; }
        .cmp-cell { font-size:.78rem; }
        .result-scores { gap:8px; }
    }
</style>

@* ─── Active run: GitHub-style pipeline ─── *@
@if (_activeRun is { } run)
{
    DateTimeOffset elapsedUntil = run.EndUtc ?? DateTimeOffset.UtcNow;
    string elapsed = FormatDuration(elapsedUntil - (run.ActualStartUtc ?? run.ScheduledStartUtc));
    <div style="overflow-x:hidden;max-width:100%;">
    <div class="wf-card mb-5">
        @{
            string statusCls = run.Status.ToString().ToLowerInvariant();
            // Stopped/failed runs freeze the bar wherever it was; Completed pins it to 100.
            double barPct = run.Status switch
            {
                TestRunStatus.Completed => 100,
                TestRunStatus.Scheduled => 0,
                _ => run.ElapsedPct,
            };
        }
        <div class="wf-header">
            <div style="flex:1;min-width:0;">
                <div class="wf-title" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                    <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;">@(string.IsNullOrWhiteSpace(run.RunLabel) ? run.PlanName : run.RunLabel)</span>
                    <span class="run-status @statusCls"><span class="dot"></span>@run.Status</span>
                </div>
                @if (run.Status == TestRunStatus.Scheduled)
                {
                    <div class="wf-meta">Starts @RelativeTime(run.ScheduledStartUtc)</div>
                }
                else
                {
                    <div class="wf-meta">@run.PlanName &nbsp;·&nbsp; elapsed @elapsed &nbsp;/&nbsp; @run.TotalDurationMinutes min</div>
                }
                @if (run.LastSummary is not null)
                {
                    <div class="wf-meta" style="margin-top:2px;">@run.LastSummary</div>
                }
            </div>
            @* Progress bar is ALWAYS shown so status pill + bar stay visually connected across every state. *@
            <div class="run-bar-wrap">
                <div class="run-bar">
                    <div class="run-bar-fill @statusCls" style="width:@barPct.ToString("F0")%"></div>
                </div>
                <div class="run-bar-pct">
                    <span>@barPct.ToString("F0")%</span>
                    <span>@(run.Status == TestRunStatus.Completed ? "done" : run.Status is TestRunStatus.Cancelled or TestRunStatus.Stopped ? "stopped early" : run.Status == TestRunStatus.Failed ? "failed" : $"{run.TotalDurationMinutes}m total")</span>
                </div>
            </div>
            @if (run.Status is TestRunStatus.Scheduled or TestRunStatus.Running)
            {
                <button class="cancel-btn-sm" @onclick="StopRun" style="flex-shrink:0;">Stop now</button>
            }
        </div>
        @foreach (TestTask task in ActivePlan?.Tasks ?? (IList<TestTask>)Array.Empty<TestTask>())
        {
            TaskPhase phase = GetTaskPhase(task, run);
            double pct = GetTaskPct(task, run);
            <div class="job-row @(phase == TaskPhase.Running ? "running" : "")">
                <div class="job-icon">
                    @if (phase == TaskPhase.Running) { <div class="icon-spin"></div> }
                    else if (phase == TaskPhase.Done) { <div class="icon-ok"></div> }
                    else if (phase == TaskPhase.Stopped) { <div class="icon-stop"></div> }
                    else { <div class="icon-ring"></div> }
                </div>
                <div class="job-body">
                    <div class="job-name">
                        @task.DisplayLabel
                        <span class="tbadge @TaskBadgeClass(task.Type)">@task.Type</span>
                        @if (task.OffsetMinutes > 0)
                        {
                            <span style="font-size:.7rem;color:var(--mud-palette-text-secondary);font-weight:400;">+@(task.OffsetMinutes)m offset</span>
                        }
                    </div>
                    <div class="job-sub">
                        @if (phase == TaskPhase.Waiting) { <text>waiting&nbsp;·&nbsp;starts in @(task.OffsetMinutes) min</text> }
                        else if (phase == TaskPhase.Running) { <text>running&nbsp;·&nbsp;@task.DurationMinutes min window&nbsp;·&nbsp;@(pct.ToString("F0"))% complete</text> }
                        else if (phase == TaskPhase.Stopped) { <text>stopped&nbsp;·&nbsp;@(pct.ToString("F0"))% before cancel</text> }
                        else { <text>done</text> }
                    </div>
                    @if (phase != TaskPhase.Waiting)
                    {
                        <div class="job-track">
                            <div class="job-fill @(phase == TaskPhase.Running ? "running" : phase == TaskPhase.Stopped ? "stopped" : "done")" style="width:@pct.ToString("F0")%"></div>
                        </div>
                    }
                </div>
                <div class="job-dur">@task.DurationMinutes min</div>
            </div>
        }
    </div>
    </div>
}

<MudTabs Elevation="0" ApplyEffectsToContainer="false" PanelClass="pt-4" @bind-ActivePanelIndex="_activeTab">

@* ═══ Plans (default) ═══ *@
<MudTabPanel Text="Plans">
<div class="tab-content">
    <div class="sec-head">
        <div style="min-width:0;">
            <div class="sec-title">Base tests</div>
            <div class="sec-sub">The two standard benchmarks. Configure environment and batches before each run.</div>
        </div>
    </div>

    @foreach (TestPlan plan in _plans.Where(p => p.IsBasePlan))
    {
        <div class="wf-card mb-4">
            <div class="wf-header">
                <div style="flex:1;min-width:0;">
                    <div class="wf-title">
                        @plan.DisplayName
                        @if (plan.IsBasePlan)
                        {
                            <span style="margin-left:6px;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--mud-palette-primary);">base</span>
                        }
                    </div>
                    <div class="wf-meta" style="margin-top:3px;">
                        @plan.Tasks.Count job(s) &nbsp;·&nbsp; @plan.TotalDurationMinutes min session
                        @if (plan.EnvironmentKeys.Count > 0) { <text>&nbsp;·&nbsp; @string.Join(", ", plan.EnvironmentKeys)</text> }
                    </div>
                    <div class="wf-meta" style="margin-top:4px;">
                        @(plan.Id == TestPlanRegistry.PullPlanId
                            ? "Scope: all inbound HES traffic"
                            : $"Environment: {(plan.EnvironmentKeys.Count == 0 ? "not configured" : string.Join(", ", plan.EnvironmentKeys))}")
                    </div>
                </div>
                <div class="wf-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               Disabled="@(_testRunActive||plan.Tasks.Count==0||BaseConfigurationError(plan) is not null)"
                               OnClick="@(()=>OpenRunDialog(plan))">Run</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               OnClick="@(()=>OpenEditPlan(plan))">Edit</MudButton>
                </div>
            </div>

            @if (plan.Tasks.Count == 0)
            {
                <div class="job-row"><span class="wf-meta">No jobs yet — click Edit to add.</span></div>
            }
            else
            {
                @foreach (TestTask task in plan.Tasks)
                {
                    <div class="job-row">
                        <div class="job-icon"><div class="icon-ring"></div></div>
                        <div class="job-body">
                            <div class="job-name">
                                @task.DisplayLabel
                                <span class="tbadge @TaskBadgeClass(task.Type)">@task.Type</span>
                            </div>
                            <div class="job-sub">
                                @TaskDetails(task)
                                &nbsp;·&nbsp; batches: @BatchSummary(task)
                                &nbsp;·&nbsp; @(task.OffsetMinutes==0?"immediate":$"+{task.OffsetMinutes} min offset")
                                &nbsp;·&nbsp; @task.DurationMinutes min
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    <div class="sec-head" style="margin-top:28px;">
        <div style="min-width:0;"><div class="sec-title">Custom plans</div><div class="sec-sub">Create ad-hoc scenarios. Their results remain visible, but Base tests are shown first.</div></div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddPlan">Add custom plan</MudButton>
    </div>
    @foreach (TestPlan plan in _plans.Where(p => !p.IsBasePlan))
    {
        <div class="wf-card mb-4">
            <div class="wf-header">
                <div style="flex:1;min-width:0;"><div class="wf-title">@plan.DisplayName</div></div>
                <div class="wf-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Disabled="@(_testRunActive||plan.Tasks.Count==0)" OnClick="@(()=>OpenRunDialog(plan))">Run</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(()=>OpenEditPlan(plan))">Edit</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(()=>DeletePlan(plan))">Delete</MudButton>
                </div>
            </div>
            @foreach (TestTask task in plan.Tasks)
            {
                <div class="job-row"><div class="job-icon"><div class="icon-ring"></div></div><div class="job-body"><div class="job-name">@task.DisplayLabel <span class="tbadge @TaskBadgeClass(task.Type)">@task.Type</span></div><div class="job-sub">@TaskDetails(task)</div></div></div>
            }
        </div>
    }
</div>
</MudTabPanel>

@* ═══ Results ═══ *@
<MudTabPanel Text="Results">
<div class="tab-content">

    @PlanFilterBar

    @if (_reports.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">No results yet. Run a plan from the Plans tab.</MudAlert>
    }
    else
    {
        @* History list *@
        <div class="sec-head">
            <span class="sec-title">Run history</span>
            <span class="sec-sub">select 1 for detail &nbsp;·&nbsp; 2&ndash;@MaxCompare to compare &nbsp;·&nbsp; 20 kept per plan</span>
        </div>
        <div class="wf-card mb-4">
            <div class="result-head">
                <div class="result-check"></div>
                    <div class="result-info">Run</div>
                    <div class="result-scores">
                        <div class="result-score">Pull</div>
                        <div class="result-score">Push</div>
                    </div>
                <span class="result-status" style="background:transparent;">Status</span>
                <span class="result-actions">More</span>
            </div>
            @foreach (TestRunReport r in VisibleReports())
            {
                bool sel = _selectedIds.Contains(r.RunId);
                <div class="result-row @(sel?"sel":"")" @onclick="@(()=>ToggleSelect(r.RunId))">
                    <div class="result-check">@(sel ? "✓" : "")</div>
                    <div class="result-info">
                        <div class="result-name">@(string.IsNullOrWhiteSpace(r.RunLabel) ? r.PlanName : r.RunLabel)</div>
                        <div class="result-meta">
                            <span>@r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm")</span>
                            @if (!string.IsNullOrWhiteSpace(r.RunLabel)) { <span>·</span><span>@r.PlanName</span> }
                            @foreach (TaskRunReport t in r.Tasks.Take(3)) { <span class="tbadge @TaskBadgeClass(t.TaskType)">@ShortType(t.TaskType)</span> }
                        </div>
                    </div>
                    <div class="result-scores">
                        <div class="result-score"><div class="result-score-val">@PullValue(r, PullScore(r).ToString("N0"))</div></div>
                        <div class="result-score"><div class="result-score-val">@PushValue(r, PushScore(r).ToString("N0"))</div></div>
                    </div>
                    <span class="result-status" style="background:color-mix(in srgb,@(r.FinalStatus==TestRunStatus.Completed?"var(--mud-palette-success)":"var(--mud-palette-default)") 15%,transparent);color:@(r.FinalStatus==TestRunStatus.Completed?"var(--mud-palette-success)":"var(--mud-palette-text-secondary)");">@r.FinalStatus</span>
                    <div class="result-actions" @onclick:stopPropagation>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(()=>OpenRenameRun(r))">Rename</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.DeleteOutline" IconColor="Color.Error" OnClick="@(()=>ConfirmDeleteRun(r))">Delete</MudMenuItem>
                        </MudMenu>
                    </div>
                </div>
            }
        </div>
    }
</div>
</MudTabPanel>

@* ═══ Leaderboard ═══ *@
@if (ShowLeaderboard)
{
<MudTabPanel Text="Leaderboard">
<div class="tab-content">
    @PlanFilterBar
    <div style="display:flex;gap:8px;margin:-8px 0 18px;">
        <MudButton Size="Size.Small" Variant="@(_leaderboardMode == ScoreMode.Pull ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(()=>_leaderboardMode=ScoreMode.Pull)">Pull score</MudButton>
        <MudButton Size="Size.Small" Variant="@(_leaderboardMode == ScoreMode.Push ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(()=>_leaderboardMode=ScoreMode.Push)">Push score</MudButton>
    </div>

    @if (_reports.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">No results yet. Run a plan first.</MudAlert>
    }
    else
    {
        <div class="sec-head">
            <span class="sec-title">Base leaderboards — @(_leaderboardMode == ScoreMode.Pull ? "Pull" : "Push") score</span>
            <span class="sec-sub">Test Pull and Test Push only &nbsp;·&nbsp; ranked by best one-minute score</span>
        </div>
        @* "Global" spans all plans — it has no meaning once a plan filter is on *@
        @if (false)
        {
            <div class="wf-card mb-4">
                <div class="wf-header"><span class="wf-title">Global &mdash; top 10</span></div>
                @{ int gi2 = 0; }
                @foreach (TestRunReport r in GlobalTop())
                {
                    int rank = ++gi2;
                    string rankCls = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
                    int gMax = GlobalTopMax();
                    double barPct = gMax > 0 ? (double)r.RawBenchScore / gMax * 100 : 0;
                    <div class="lb-row @(_selectedIds.Contains(r.RunId) ? "sel" : "")" @onclick="@(()=>ToggleSelect(r.RunId))">
                        <div class="lb-rank @rankCls">#@rank</div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:.84rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@(string.IsNullOrWhiteSpace(r.RunLabel)?r.PlanName:r.RunLabel)</div>
                            <div style="font-size:.7rem;color:var(--mud-palette-text-secondary);">@r.PlanName &nbsp;·&nbsp; @r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm") &nbsp;·&nbsp; @r.OverallSuccessRatePct.ToString("F1")%</div>
                            <div style="margin-top:5px;height:3px;background:var(--mud-palette-lines-default);border-radius:2px;overflow:hidden;">
                                <div class="lb-bar @rankCls" style="width:@barPct.ToString("F0")%"></div>
                            </div>
                        </div>
                        <div style="text-align:right;flex-shrink:0;padding-left:14px;">
                            <div style="font-family:ui-monospace,monospace;font-weight:800;font-size:.95rem;color:var(--mud-palette-success);">@r.RawBenchScore.ToString("N0")</div>
                            <div style="font-size:.68rem;color:var(--mud-palette-text-secondary);font-family:ui-monospace,monospace;">@r.NormalizedBenchScore.ToString("N0") norm</div>
                        </div>
                    </div>
                }
            </div>
        }
        @foreach (var pg in PerPlanGroups())
        {
            int pMax = pg.Top.Count > 0 ? LeaderboardScore(pg.Top[0]) : 1;
            <div class="wf-card mb-3">
                <div class="wf-header"><span class="wf-title">@pg.PlanName</span><span class="wf-meta">top @pg.Top.Count &nbsp;·&nbsp; 20/plan</span></div>
                @{ int pi2 = 0; }
                @foreach (TestRunReport r in pg.Top)
                {
                    int rank = ++pi2;
                    string rankCls = rank == 1 ? "gold" : rank == 2 ? "silver" : rank == 3 ? "bronze" : "";
                    double barPct = pMax > 0 ? (double)LeaderboardScore(r) / pMax * 100 : 0;
                    <div class="lb-row @(_selectedIds.Contains(r.RunId) ? "sel" : "")" @onclick="@(()=>ToggleSelect(r.RunId))">
                        <div class="lb-rank @rankCls">#@rank</div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:.84rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@(string.IsNullOrWhiteSpace(r.RunLabel)?r.PlanName:r.RunLabel)</div>
                            <div style="font-size:.7rem;color:var(--mud-palette-text-secondary);">@r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm") &nbsp;·&nbsp; @r.OverallSuccessRatePct.ToString("F1")%</div>
                            <div style="margin-top:5px;height:3px;background:var(--mud-palette-lines-default);border-radius:2px;overflow:hidden;">
                                <div class="lb-bar @rankCls" style="width:@barPct.ToString("F0")%"></div>
                            </div>
                        </div>
                        <div style="text-align:right;flex-shrink:0;padding-left:14px;">
                            <div style="font-family:ui-monospace,monospace;font-weight:800;font-size:.95rem;color:var(--mud-palette-success);">@LeaderboardScore(r).ToString("N0")</div>
                            <div style="font-size:.68rem;color:var(--mud-palette-text-secondary);font-family:ui-monospace,monospace;">@(_leaderboardMode == ScoreMode.Pull ? "pull" : "push")</div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
</MudTabPanel>

@* ═══ Push ═══ *@
}
<MudTabPanel Text="Push">
<div class="tab-content">
    <div class="sec-head">
        <div style="min-width:0;">
            <div class="sec-title">On-demand push</div>
            <div class="sec-sub">Ad-hoc checks against a live batch. Base results come from the <b>Test Push</b> plan.</div>
        </div>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Loop"
                   OnClick="OpenLoopDialog" Disabled="@_testRunActive">Loop push</MudButton>
    </div>

    @if (_scheduleState.IntervalMinutes > 0)
    {
        <MudAlert Severity="@(_scheduleState.IsRunning ? Severity.Info : Severity.Normal)" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            @if (_scheduleState.IsRunning)
            {
                <text>Loop every @_scheduleState.IntervalMinutes min over @_scheduleState.BatchIds.Count batch(es) · next @RelativeTime(_scheduleState.NextRunUtc)</text>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="ml-2" OnClick="StopLoop">Stop</MudButton>
            }
            else { <text>Loop stopped.</text> }
            @if (_scheduleState.LastSummary is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    Last @RelativeTime(_scheduleState.LastRunUtc): @_scheduleState.LastSummary
                </MudText>
            }
        </MudAlert>
    }

    @if (_testRunActive)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            A test run is active &mdash; on-demand push is disabled until it completes.
        </MudAlert>
    }

    @if (_batches.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">No batches yet.</MudAlert>
    }
    else
    {
        <div class="wf-card">
            <div class="result-head">
                <div class="result-info">Batch</div>
                <div style="width:90px;text-align:right;flex-shrink:0;">Count</div>
                <div style="width:90px;flex-shrink:0;">Status</div>
                <div style="width:110px;flex-shrink:0;"></div>
            </div>
            @foreach (MeterBatch b in _batches)
            {
                <div class="result-row" style="cursor:default;">
                    <div class="result-info">
                        <div class="result-name">@b.Name</div>
                        <div class="result-meta">
                            <span class="tbadge tbadge-push">@NicLabel(b.NicType)</span>
                            @if (_scheduleState.IsRunning && _scheduleState.BatchIds.Contains(b.Id)) { <span>· looping</span> }
                        </div>
                    </div>
                    <div class="mono" style="width:90px;text-align:right;flex-shrink:0;font-size:.85rem;">@b.Count.ToString("N0")</div>
                    <div style="width:90px;flex-shrink:0;">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(b.Status)">@b.Status</MudChip>
                    </div>
                    <div style="width:110px;flex-shrink:0;text-align:right;">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(_pushingBatchIds.Contains(b.Id) || _testRunActive)"
                                   OnClick="@(() => SendPushAsync(b.Id))">
                            @(_pushingBatchIds.Contains(b.Id) ? "Sending..." : "Send")
                        </MudButton>
                    </div>
                </div>
            }
        </div>
    }
</div>
</MudTabPanel>
</MudTabs>

@* ─── Selection detail / comparison — shared by Results + Leaderboard ─── *@
@if (_activeTab == 1)
{
    @* ─── Single run detail ─── *@
    @if (_reports.Count > 0 && _selectedIds.Count == 1)
    {
        TestRunReport? r = _reports.FirstOrDefault(x => _selectedIds.Contains(x.RunId));
        if (r is not null)
        {
                <div style="margin-bottom:32px;">
                    <div class="sec-head sec-gap">
                        <div style="min-width:0;">
                            <div class="sec-title">@(string.IsNullOrWhiteSpace(r.RunLabel) ? r.PlanName : r.RunLabel)</div>
                            <div class="sec-sub">@r.StartUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm") &nbsp;·&nbsp; @r.PlanName &nbsp;·&nbsp; @FormatDuration(r.EndUtc - r.StartUtc)</div>
                        </div>
                        <a href="/reports/@(r.RunId).json" style="font-size:.75rem;color:var(--mud-palette-primary);text-decoration:none;white-space:nowrap;" @onclick="@(async()=>await DownloadReport(r.RunId))" @onclick:preventDefault>
                            ↓ download json
                        </a>
                    </div>

                    @if (r.PlanId == TestPlanRegistry.PullPlanId)
                    {
                        <div class="sec-title" style="font-size:.9rem;margin:0 0 8px;">Pull metrics</div>
                        <div class="metrics-strip">
                            @MetricCell("★ SELECTED BEST MINUTE", r.BestMinuteScore.ToString("N0") + " exchanges", "var(--mud-palette-success)")
                            @MetricCell("★ SELECTED MINUTE EPS", (r.BestMinuteScore / 60.0).ToString("F2"), "var(--mud-palette-success)")
                            @MetricCell("★ PEAK PARALLEL", r.Tasks.Where(t => t.TaskType == TestTaskType.PullListener).DefaultIfEmpty().Max(t => t?.PeakConcurrentSessions ?? 0).ToString("N0"), "var(--mud-palette-success)")
                            @MetricCell("★ AVG PARALLEL", r.Tasks.Where(t => t.TaskType == TestTaskType.PullListener).DefaultIfEmpty().Max(t => t?.AvgConcurrentSessions ?? 0).ToString("F1"), "var(--mud-palette-success)")
                        </div>
                        <div class="sec-sub mb-3">★ Metrics are used for the Base Pull leaderboard. CPU, memory, and network/broker latency are diagnostic only.</div>
                    }
                    else
                    {
                        <div class="sec-title" style="font-size:.9rem;margin:0 0 8px;">Push metrics</div>
                        <div class="metrics-strip">
                            @MetricCell("★ BENCHMARK / MIN", r.BestMinuteScore.ToString("N0") + " pushes", "var(--mud-palette-success)")
                            @MetricCell("★ AVG MINUTE", r.AverageMinuteScore.ToString("N0"), "var(--mud-palette-success)")
                            @MetricCell("SUCCESS", r.OverallSuccessRatePct.ToString("F1") + "%", null)
                            @MetricCell("THROUGHPUT /min", r.OverallThroughputPerMin.ToString("F0"), null)
                            @MetricCell("P95 ms", r.OverallP95Ms.ToString("F0"), null)
                            @MetricCell("MEDIAN ms", r.OverallMedianMs.ToString("F0"), null)
                        </div>
                        <div class="sec-sub mb-3">★ Metrics are used for the Base Push leaderboard. CPU, memory, and network/broker latency are diagnostic only.</div>
                    }

                    <div class="sec-title" style="font-size:.9rem;margin:0 0 8px;">Debug</div>
                    <div class="metrics-strip mb-3">
                        @MetricCell("BEST MINUTE EXCHANGES", r.BestMinuteScore.ToString("N0"), null)
                        @MetricCell("RUN AVG EPS", r.AverageInboundExchangesPerSecond.ToString("F2"), null)
                        @MetricCell("TOTAL HES EXCHANGES", r.TotalInboundExchanges.ToString("N0"), null)
                        @MetricCell("HES REACHED", r.TotalInboundConnections.ToString("N0"), null)
                        @MetricCell("HES LATENCY ms", r.AvgInboundLatencyMs.ToString("F0"), null)
                        @MetricCell("SIM AVG CPU %", r.AvgCpuPct.ToString("F1"), null)
                        @MetricCell("SIM PEAK RAM MB", r.PeakRamMb.ToString("N0"), null)
                    </div>

                    @if (r.OfficialBenchmarkProfileApplied)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                            Base profile: BadComm and non-comm disabled; network delay randomized from @r.NetworkDelayLowerMs–@r.NetworkDelayUpperMs ms. The previous runtime settings were restored after the run.
                        </MudAlert>
                    }

                    @* Task breakdown *@
                    @if (r.Tasks.Count > 0)
                    {
                        <div class="wf-card mb-3">
                            <div class="wf-header"><span class="wf-title">Job breakdown</span></div>
                            @foreach (TaskRunReport t in r.Tasks)
                            {
                                <div class="job-row">
                                    <div class="job-icon"><div class="icon-ok"></div></div>
                                    <div class="job-body">
                                        <div class="job-name">
                                            @t.TaskLabel
                                            <span class="tbadge @TaskBadgeClass(t.TaskType)">@ShortType(t.TaskType)</span>
                                            <span style="font-size:.72rem;color:var(--mud-palette-text-secondary);font-weight:400;">score @t.TaskScore.ToString("N0")</span>
                                        </div>
                                        <div class="job-sub">
                                            @if (t.TaskType == TestTaskType.PullListener)
                                            {
                                                <text>pulls @t.PullsAnswered / @t.PullsReceived</text>
                                                @if (t.PeakConcurrentSessions > 0)
                                                {
                                                    <text> &nbsp;·&nbsp; peak @t.PeakConcurrentSessions concurrent &nbsp;·&nbsp; avg @t.AvgConcurrentSessions.ToString("F1") &nbsp;·&nbsp; @t.SessionRatePerMin.ToString("F2")/min session rate</text>
                                                }
                                            }
                                            else
                                            {
                                                <text>pushed @t.TotalPushed.ToString("N0") &nbsp;·&nbsp; @t.SuccessRatePct.ToString("F1")% success &nbsp;·&nbsp; @t.ThroughputPerMin.ToString("F0")/min &nbsp;·&nbsp; P95 @t.P95Ms.ToString("F0")ms</text>
                                                @if (t.TotalActiveMs > 0)
                                                {
                                                    <text> &nbsp;·&nbsp; @((t.TotalActiveMs/1000.0).ToString("F1"))s active</text>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <div class="job-dur">@t.DurationMinutes min</div>
                                </div>
                            }
                        </div>
                    }

                    @* Per-environment *@
                    @if (_showLegacyEnvironmentScores && r.Environments.Where(e => _filterEnvs.Count == 0 || _filterEnvs.Contains(e.EnvironmentKey)).ToList() is { Count: > 0 } envs)
                    {
                        <div class="wf-card">
                            <div class="wf-header"><span class="wf-title">Per environment</span></div>
                            @foreach (EnvironmentRunReport env in envs)
                            {
                                <div class="job-row">
                                    <div class="job-body">
                                        <div class="job-name">@env.EnvironmentKey</div>
                                        <div class="job-sub">
                                            score @env.BenchScore.ToString("N0") &nbsp;·&nbsp;
                                            @env.SuccessRatePct.ToString("F1")% success &nbsp;·&nbsp;
                                            @env.ThroughputPerMin.ToString("F0")/min &nbsp;·&nbsp;
                                            P95 @env.P95Ms.ToString("F0")ms
                                        </div>
                                    </div>
                                    <div class="job-dur mono" style="font-size:.82rem;font-weight:700;color:var(--mud-palette-success);">@env.BenchScore.ToString("N0")</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

    @* ─── N-way comparison (2–5 runs) ─── *@
    @if (_reports.Count > 0 && _selectedIds.Count >= 2)
    {
        // preserve selection order so columns match the order the user clicked
        var runs = _selectedIds
            .Select(id => _reports.FirstOrDefault(r => r.RunId == id))
            .Where(r => r is not null).Select(r => r!)
            .ToList();

        if (runs.Count >= 2)
        {
            int bestIdx = runs.IndexOf(runs.OrderByDescending(r => r.RawBenchScore).First());
            string gridCols = $"minmax(110px,1.1fr) repeat({runs.Count},minmax(0,1fr))";
            var envKeys = runs
                .SelectMany(r => r.Environments.Select(e => e.EnvironmentKey))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(k => k)
                .ToList();
            var pullMetrics = new (string Label, Func<TestRunReport,double> Val, bool HighGood, Func<TestRunReport,string> Fmt)[]
            {
                ("Pull score", r=>PullScore(r), true, r=>PullValue(r, PullScore(r).ToString("N0"))),
                ("Selected minute EPS", r=>r.BestMinuteScore / 60.0, true, r=>PullValue(r, (r.BestMinuteScore / 60.0).ToString("F2"))),
                ("Peak parallel exchanges", r=>r.Tasks.Where(t=>t.TaskType == TestTaskType.PullListener).DefaultIfEmpty().Max(t=>t?.PeakConcurrentSessions ?? 0), true, r=>PullValue(r, r.Tasks.Where(t=>t.TaskType == TestTaskType.PullListener).DefaultIfEmpty().Max(t=>t?.PeakConcurrentSessions ?? 0).ToString("N0"))),
                ("Avg parallel exchanges", r=>r.Tasks.Where(t=>t.TaskType == TestTaskType.PullListener).DefaultIfEmpty().Max(t=>t?.AvgConcurrentSessions ?? 0), true, r=>PullValue(r, r.Tasks.Where(t=>t.TaskType == TestTaskType.PullListener).DefaultIfEmpty().Max(t=>t?.AvgConcurrentSessions ?? 0).ToString("F1"))),
            };
            var pushMetrics = new (string Label, Func<TestRunReport,double> Val, bool HighGood, Func<TestRunReport,string> Fmt)[]
            {
                ("Push score", r=>PushScore(r), true, r=>PushValue(r, PushScore(r).ToString("N0"))),
                ("Selected minute pushed", r=>PushScore(r), true, r=>PushValue(r, PushScore(r).ToString("N0"))),
                ("Push success %", r=>r.OverallSuccessRatePct, true, r=>PushValue(r, r.OverallSuccessRatePct.ToString("F2")+"%")),
                ("Push throughput / min", r=>r.OverallThroughputPerMin, true, r=>PushValue(r, r.OverallThroughputPerMin.ToString("F1"))),
            };
            var debugMetrics = new (string Label, Func<TestRunReport,double> Val, bool HighGood, Func<TestRunReport,string> Fmt)[]
            {
                ("Overall window HES exchanges", r=>r.TotalInboundExchanges, true, r=>PullValue(r, r.TotalInboundExchanges.ToString("N0"))),
                ("Overall window HES reached", r=>r.TotalInboundConnections, true, r=>PullValue(r, r.TotalInboundConnections.ToString("N0"))),
                ("Total pushed", r=>r.TotalMetersPushed, true, r=>PushValue(r, r.TotalMetersPushed.ToString("N0"))),
                ("Failed", r=>r.TotalMetersFailed, false, r=>PushValue(r, r.TotalMetersFailed.ToString("N0"))),
                ("P95 push latency ms", r=>r.OverallP95Ms, false, r=>PushValue(r, r.OverallP95Ms.ToString("F0"))),
                ("Median push latency ms", r=>r.OverallMedianMs, false, r=>PushValue(r, r.OverallMedianMs.ToString("F0"))),
                ("HES latency ms", r=>r.AvgInboundLatencyMs, false, r=>PullValue(r, r.AvgInboundLatencyMs.ToString("F0"))),
                ("Avg CPU %", r=>r.AvgCpuPct, false, r=>r.AvgCpuPct.ToString("F1")+"%"),
                ("Peak RAM MB", r=>r.PeakRamMb, false, r=>r.PeakRamMb.ToString("N0")),
            };

            <div class="sec-head sec-gap">
                <span class="sec-title">Comparison &mdash; @runs.Count runs</span>
                <span class="sec-sub">green = best value in the row &nbsp;·&nbsp; up to @MaxCompare selectable</span>
            </div>

            <div class="cmp-scroll mb-4">
            <div class="cmp-table" style="min-width:@(160 + runs.Count * 150)px;">
                @* Header uses the same grid template as every row below, so columns line up *@
                <div class="cmp-grid cmp-head-row" style="grid-template-columns:@gridCols;">
                    <div class="cmp-corner">Metric</div>
                    @for (int ci = 0; ci < runs.Count; ci++)
                    {
                        var r = runs[ci];
                        bool wins = ci == bestIdx;
                        <div class="cmp-head-cell">
                            <div class="cmp-head-name">
                                @(string.IsNullOrWhiteSpace(r.RunLabel) ? r.PlanName : r.RunLabel)
                                @if (wins) { <span style="font-size:.62rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--mud-palette-success);">best</span> }
                            </div>
                            <div class="cmp-head-meta">@r.StartUtc.LocalDateTime.ToString("MM/dd HH:mm") &nbsp;·&nbsp; @r.PlanName</div>
                            <div class="cmp-head-score">
                                <span class="score-big" style="color:@(wins ? "var(--mud-palette-success)" : "inherit");">@r.RawBenchScore.ToString("N0")</span>
                                <span class="score-norm">/ @r.NormalizedBenchScore.ToString("N0")</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="cmp-grid" style="grid-template-columns:@gridCols;"><div class="cmp-section cmp-pull">Pull — selected best minute (score inputs)</div></div>
                @foreach (var (label, valFn, highGood, fmtFn) in pullMetrics)
                {
                    var vals = runs.Select(valFn).ToList();
                    double target = highGood ? vals.Max() : vals.Min();
                    bool allTied = Math.Abs(vals.Max() - vals.Min()) < 0.001;
                    <div class="cmp-grid cmp-row" style="grid-template-columns:@gridCols;">
                        <div class="cmp-label">@label</div>
                        @for (int ci = 0; ci < runs.Count; ci++)
                        {
                            bool best = !allTied && Math.Abs(vals[ci] - target) < 0.001;
                            <div class="cmp-cell @(best ? "best" : "")">@fmtFn(runs[ci])</div>
                        }
                    </div>
                }

                <div class="cmp-grid" style="grid-template-columns:@gridCols;"><div class="cmp-section cmp-push">Push — selected best minute (score inputs)</div></div>
                @foreach (var (label, valFn, highGood, fmtFn) in pushMetrics)
                {
                    var vals = runs.Select(valFn).ToList();
                    double target = highGood ? vals.Max() : vals.Min();
                    bool allTied = Math.Abs(vals.Max() - vals.Min()) < 0.001;
                    <div class="cmp-grid cmp-row" style="grid-template-columns:@gridCols;">
                        <div class="cmp-label">@label</div>
                        @for (int ci = 0; ci < runs.Count; ci++)
                        {
                            bool best = !allTied && Math.Abs(vals[ci] - target) < 0.001;
                            <div class="cmp-cell @(best ? "best" : "")">@fmtFn(runs[ci])</div>
                        }
                    </div>
                }

                <div class="cmp-grid" style="grid-template-columns:@gridCols;"><div class="cmp-section cmp-debug">Debug — not used in benchmark score</div></div>
                @foreach (var (label, valFn, highGood, fmtFn) in debugMetrics)
                {
                    var vals = runs.Select(valFn).ToList();
                    double target = highGood ? vals.Max() : vals.Min();
                    bool allTied = Math.Abs(vals.Max() - vals.Min()) < 0.001;
                    <div class="cmp-grid cmp-row" style="grid-template-columns:@gridCols;">
                        <div class="cmp-label">@label</div>
                        @for (int ci = 0; ci < runs.Count; ci++)
                        {
                            bool best = !allTied && Math.Abs(vals[ci] - target) < 0.001;
                            <div class="cmp-cell @(best ? "best" : "")">@fmtFn(runs[ci])</div>
                        }
                    </div>
                }

                @if (_showLegacyEnvironmentScores && envKeys.Count > 0)
                {
                    <div class="cmp-grid" style="grid-template-columns:@gridCols;"><div class="cmp-section">Per environment &mdash; score</div></div>
                    @foreach (string ek in envKeys)
                    {
                        var scores = runs
                            .Select(r => r.Environments.FirstOrDefault(e => string.Equals(e.EnvironmentKey, ek, StringComparison.OrdinalIgnoreCase))?.BenchScore)
                            .ToList();
                        int? envBest = scores.Where(s => s.HasValue).Select(s => s!.Value).DefaultIfEmpty().Max();
                        bool envTied = scores.Where(s => s.HasValue).Select(s => s!.Value).Distinct().Count() <= 1;
                        <div class="cmp-grid cmp-row" style="grid-template-columns:@gridCols;">
                            <div class="cmp-label">@ek</div>
                            @for (int ci = 0; ci < runs.Count; ci++)
                            {
                                bool best = !envTied && scores[ci].HasValue && scores[ci] == envBest;
                                <div class="cmp-cell @(best ? "best" : "")">@(scores[ci]?.ToString("N0") ?? "--")</div>
                            }
                        </div>
                    }
                }
            </div>
            </div>
        }
    }
}

@* ─── Loop push dialog ─── *@
<MudDialog @bind-Visible="_loopOpen" Options="@(new DialogOptions{MaxWidth=MaxWidth.Small,FullWidth=true})">
    <TitleContent><MudText Typo="Typo.h6">Loop push</MudText></TitleContent>
    <DialogContent>
        <MudSelect T="int" @bind-SelectedValues="_loopBatchIds" Label="Batches" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4">
            @foreach (MeterBatch b in _batches) { <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType))</MudSelectItem> }
        </MudSelect>
        <MudSelect T="int" @bind-Value="_loopIntervalMin" Label="Interval" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (int m in PushScheduleService.AllowedIntervalMinutes) { <MudSelectItem T="int" Value="@m">Every @m min</MudSelectItem> }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=>_loopOpen=false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_loopBatchIds.Any())" OnClick="StartLoop">Start</MudButton>
    </DialogActions>
</MudDialog>

@* ─── Run dialog ─── *@
<MudDialog @bind-Visible="_runOpen" Options="@(new DialogOptions{MaxWidth=MaxWidth.Small,FullWidth=true})">

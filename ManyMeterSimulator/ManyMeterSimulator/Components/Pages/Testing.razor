    private static int PullScore(TestRunReport r) => r.PullBenchScore != 0
        ? r.PullBenchScore : r.PlanId == TestPlanRegistry.PullPlanId ? r.RawBenchScore : 0;
    private static int PushScore(TestRunReport r) => r.PushBenchScore != 0
        ? r.PushBenchScore : r.PlanId == TestPlanRegistry.PushPlanId ? r.RawBenchScore : 0;
    private static int OverallScore(TestRunReport r) => r.PullBenchScore != 0 || r.PushBenchScore != 0
        ? r.OverallBenchScore : r.RawBenchScore;
    private static bool HasPullMetrics(TestRunReport r) => r.Tasks.Any(t => t.TaskType == TestTaskType.PullListener)
        || r.PlanId == TestPlanRegistry.PullPlanId;
    private static bool HasPushMetrics(TestRunReport r) => r.Tasks.Any(t => t.TaskType is TestTaskType.PushLoop or TestTaskType.BurstPush or TestTaskType.PartialPush)
        || r.PlanId == TestPlanRegistry.PushPlanId;
    private static string PullValue(TestRunReport r, string value) => HasPullMetrics(r) ? value : "";
    private static string PushValue(TestRunReport r, string value) => HasPushMetrics(r) ? value : "";
    private int LeaderboardScore(TestRunReport r) => _leaderboardMode == ScoreMode.Pull ? PullScore(r) : PushScore(r);

    private IList<TestRunReport> GlobalTop() =>
        _reports.Where(PlanVisible).OrderByDescending(LeaderboardScore).Take(10).ToList();

    private int GlobalTopMax()
    {
        var vis = _reports.Where(PlanVisible).ToList();
        return vis.Count > 0 ? Math.Max(1, vis.Max(LeaderboardScore)) : 1;
    }

    private record PlanGroup(string PlanName, IList<TestRunReport> Top);
    private IList<PlanGroup> PerPlanGroups() =>
        _reports
            .Where(r => PlanVisible(r) && LeaderboardScore(r) > 0)
            .GroupBy(r => r.PlanId)
            .Select(g => new PlanGroup(g.First().PlanName, g.OrderByDescending(LeaderboardScore).Take(5).ToList()))
            .OrderBy(g => g.Top.First().PlanId is TestPlanRegistry.PullPlanId or TestPlanRegistry.PushPlanId ? 0 : 1)
            .ThenBy(g => g.PlanName).ToList();

    // Pipeline helpers
    private enum TaskPhase { Waiting, Running, Done, Stopped }

    private static TaskPhase GetTaskPhase(TestTask task, TestRunState run)
    {
        if (run.Status == TestRunStatus.Scheduled || run.ActualStartUtc is null) return TaskPhase.Waiting;
        // A cleanly completed run means every task ran to conclusion — burst tasks legitimately
        // return early once their burst count is done, so wall-clock elapsed isn't the truth here.
        if (run.Status == TestRunStatus.Completed) return TaskPhase.Done;

        DateTimeOffset until = run.EndUtc ?? DateTimeOffset.UtcNow;
        double elapsed = (until - run.ActualStartUtc.Value).TotalMinutes;
        if (elapsed < task.OffsetMinutes)
            return run.Status == TestRunStatus.Running ? TaskPhase.Waiting : TaskPhase.Stopped;
        if (elapsed >= task.EndsAtMinute) return TaskPhase.Done;
        // Mid-task at the freeze point: running if still live, stopped if the run was cancelled/failed.
        return run.Status == TestRunStatus.Running ? TaskPhase.Running : TaskPhase.Stopped;
    }

    private static double GetTaskPct(TestTask task, TestRunState run)
    {
        if (run.ActualStartUtc is null) return 0;
        if (run.Status == TestRunStatus.Completed) return 100;
        DateTimeOffset until = run.EndUtc ?? DateTimeOffset.UtcNow;
        double elapsed = (until - run.ActualStartUtc.Value).TotalMinutes - task.OffsetMinutes;
        return elapsed < 0 ? 0 : Math.Min(100, elapsed / task.DurationMinutes * 100);
    }

    // Render helpers
    private RenderFragment MetricCell(string label, string val, string? color) => builder =>
    {
        builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "metric-cell");
        builder.OpenElement(2, "div"); builder.AddAttribute(3, "class", "metric-val");
        if (color is not null) builder.AddAttribute(4, "style", $"color:{color};");
        builder.AddContent(5, val); builder.CloseElement();
        builder.OpenElement(6, "div"); builder.AddAttribute(7, "class", "metric-key");
        builder.AddContent(8, label); builder.CloseElement();
        builder.CloseElement();
    };

    private static string TaskDetails(TestTask t) => t switch
    {
        PartialPushTask pt => pt.Mode == PartialPushMode.Count
            ? $"{pt.BurstCount}x partial push of {pt.MeterCount:N0} random meters"
            : $"{pt.BurstCount}x partial push of {pt.Percentage:N0}% per batch",
        PushLoopTask pl => $"every {pl.PushIntervalSec}s · {pl.BatchIds.Count} batch(es)",
        BurstPushTask bt => $"{bt.BurstCount}× push · {bt.BatchIds.Count} batch(es)",
        _ => "monitors inbound sessions",
    };

    private string BatchSummary(TestTask task)
    {
        if (task is PullListenerTask) return "not applicable";
        IReadOnlyList<int> ids = task switch
        {
            PullListenerTask pull => pull.BatchIds,
            PushLoopTask loop => loop.BatchIds,
            BurstPushTask push => push.BatchIds,
            PartialPushTask partial => partial.BatchIds,
            _ => Array.Empty<int>(),
        };
        if (ids.Count == 0) return "not configured";
        string[] names = ids
            .Select(id => _batches.FirstOrDefault(batch => batch.Id == id)?.Name ?? $"missing #{id}")
            .ToArray();
        return string.Join(", ", names);
    }

    private string? BaseConfigurationError(TestPlan plan)
    {
        if (!plan.IsBasePlan) return null;
        if (plan.Id == TestPlanRegistry.PullPlanId)
            return plan.Tasks.OfType<PullListenerTask>().FirstOrDefault() is { DurationMinutes: > 0 }
                ? null : "set a pull duration";
        if (plan.Id == TestPlanRegistry.PushPlanId)
        {
            BurstPushTask? push = plan.Tasks.OfType<BurstPushTask>().FirstOrDefault();
            if (push is null || string.IsNullOrWhiteSpace(push.EnvironmentKey)) return "select an environment in the push task";
            if (push is null || push.BatchIds.Count == 0) return "select a 100k batch";
            if (push.BatchIds.Any(id => _batches.FirstOrDefault(b => b.Id == id)?.Count < 100_000)) return "each push batch must have at least 100k meters";
            return push.BatchIds.Any(id => !string.Equals(_batches.FirstOrDefault(b => b.Id == id)?.EnvironmentKey, push.EnvironmentKey, StringComparison.OrdinalIgnoreCase))
                ? "each batch must belong to the task environment" : null;
        }
        return null;
    }


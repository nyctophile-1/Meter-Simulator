<MudDialog @bind-Visible="_planOpen" Options="@(new DialogOptions{MaxWidth=MaxWidth.Medium,FullWidth=true})">
    <TitleContent><MudText Typo="Typo.h6">@(_editingPlan?"Edit plan":"New plan")</MudText></TitleContent>
    <DialogContent>
        <MudGrid Class="mb-3">
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_planName" Label="Name" Immediate="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_editingBase || _planLocked)" />
            </MudItem>
            @if (ShowPlanEnvironmentSelector)
            {
            <MudItem xs="12">
                <MudSelect T="string" @bind-SelectedValues="_planEnvs" Label="Environments (max 2, empty = all)" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var env in Network.Environments) { <MudSelectItem T="string" Value="@env.Key">@env.DisplayName</MudSelectItem> }
                </MudSelect>
            </MudItem>
            }
            else
            {
                <MudItem xs="12"><MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">Test Pull listens to all inbound HES traffic. Configure only its duration.</MudAlert></MudItem>
            }
        </MudGrid>

        @if (_planLocked)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                Plan shape is locked so re-runs stay comparable. You can change environments, selected batches, and duration — not the job list or type.
            </MudAlert>
        }

        <div class="d-flex align-center justify-space-between mb-1">
            <span style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--mud-palette-text-secondary);">Jobs</span>
        </div>
        <div class="wf-card mb-2">
            @if (_planTasks.Count == 0)
            {
                <div class="job-row"><span class="wf-meta">No jobs yet.</span></div>
            }
            else
            {
                @foreach (TestTask t in _planTasks)
                {
                    <div class="job-row">
                        <div class="job-icon"><div class="icon-ring"></div></div>
                        <div class="job-body">
                            <div class="job-name">@t.DisplayLabel <span class="tbadge @TaskBadgeClass(t.Type)">@t.Type</span></div>
                            <div class="job-sub">@TaskDetails(t) &nbsp;·&nbsp; @(t.OffsetMinutes==0?"immediate":$"+{t.OffsetMinutes}m offset") &nbsp;·&nbsp; @t.DurationMinutes min</div>
                        </div>
                        <div style="display:flex;gap:2px;flex-shrink:0;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(()=>OpenEditTask(t))" />
                            @if (!_planLocked)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(()=>_planTasks.Remove(t))" />
                            }
                        </div>
                    </div>
                }
            }
            @if (!_planLocked)
            {
                <div class="add-job" @onclick="OpenAddTask">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                    Add job
                </div>
            }
        </div>

        @if (_planError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">@_planError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=>_planOpen=false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePlan">Save</MudButton>
    </DialogActions>
</MudDialog>

@* ─── Task dialog ─── *@
<MudDialog @bind-Visible="_taskOpen" Options="@(new DialogOptions{MaxWidth=MaxWidth.Small,FullWidth=true})">
    <TitleContent><MudText Typo="Typo.h6">@(_taskEditing?"Edit job":"Add job")</MudText></TitleContent>
    <DialogContent>
        <MudGrid>
            @if (!_taskEditing)
            {
                <MudItem xs="12">
                    <MudSelect T="TestTaskType" @bind-Value="_taskType" Label="Job type" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="TestTaskType" Value="TestTaskType.PullListener">Pull Listener &mdash; measure all inbound HES traffic</MudSelectItem>
                        <MudSelectItem T="TestTaskType" Value="TestTaskType.PushLoop">Push Loop &mdash; repeat a full push every N seconds</MudSelectItem>
                        <MudSelectItem T="TestTaskType" Value="TestTaskType.BurstPush">All Push &mdash; N back-to-back full pushes</MudSelectItem>
                        <MudSelectItem T="TestTaskType" Value="TestTaskType.PartialPush">Partial Push &mdash; random subset of selected batches</MudSelectItem>
                    </MudSelect>
                </MudItem>
            }
            @if (_planLocked)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                        Batches and duration can be changed; the task type and timing shape are locked.
                    </MudAlert>
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_taskLabel" Label="Label (optional)" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_planLocked" />
            </MudItem>
            @if (!(_editingOfficial && _taskType == TestTaskType.BurstPush))
            {
                <MudItem xs="6">
                    <MudNumericField T="int" @bind-Value="_taskOffset" Label="Offset (min)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="240" Disabled="@_planLocked" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int" @bind-Value="_taskDuration" Label="Duration (min)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="480" Disabled="@(_planLocked && !_editingOfficial)" />
                </MudItem>
            }

            @if (_taskType == TestTaskType.PushLoop)
            {
                <MudItem xs="12"><MudSelect T="string" Value="@_taskEnvironment" ValueChanged="OnTaskEnvironmentChanged" Label="Environment" Variant="Variant.Outlined" Margin="Margin.Dense">@foreach (var env in Network.Environments) { <MudSelectItem T="string" Value="@env.Key">@env.DisplayName</MudSelectItem> }</MudSelect></MudItem>
                <MudItem xs="12">
                    <MudNumericField T="int" @bind-Value="_taskInterval" Label="Push interval (sec)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="30" Max="3600" Disabled="@_planLocked" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int" @bind-SelectedValues="_taskBatches" Label="Batches" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (MeterBatch b in TaskEnvironmentBatches) { <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType), @b.Count.ToString("N0"))</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
            else if (_taskType == TestTaskType.BurstPush)
            {
                <MudItem xs="12"><MudSelect T="string" Value="@_taskEnvironment" ValueChanged="OnTaskEnvironmentChanged" Label="Environment" Variant="Variant.Outlined" Margin="Margin.Dense">@foreach (var env in Network.Environments) { <MudSelectItem T="string" Value="@env.Key">@env.DisplayName</MudSelectItem> }</MudSelect></MudItem>
                <MudItem xs="12">
                    <MudNumericField T="int" @bind-Value="_taskBursts" Label="Push count" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" Disabled="@_planLocked" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int" @bind-SelectedValues="_taskBatches" Label="Batches (at least 100,000 meters)" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (MeterBatch b in TaskEnvironmentBatches.Where(b => b.Count >= 100_000)) { <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType), @b.Count.ToString("N0"))</MudSelectItem> }
                    </MudSelect>
                </MudItem>
            }
            else if (_taskType == TestTaskType.PartialPush)
            {
                <MudItem xs="12"><MudSelect T="string" Value="@_taskEnvironment" ValueChanged="OnTaskEnvironmentChanged" Label="Environment" Variant="Variant.Outlined" Margin="Margin.Dense">@foreach (var env in Network.Environments) { <MudSelectItem T="string" Value="@env.Key">@env.DisplayName</MudSelectItem> }</MudSelect></MudItem>
                <MudItem xs="6"><MudNumericField T="int" @bind-Value="_taskBursts" Label="Push count" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" /></MudItem>
                <MudItem xs="6"><MudSelect T="PartialPushMode" @bind-Value="_taskPartialMode" Label="Subset" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="PartialPushMode" Value="PartialPushMode.Count">Meter count</MudSelectItem><MudSelectItem T="PartialPushMode" Value="PartialPushMode.Percentage">Percentage per batch</MudSelectItem></MudSelect></MudItem>
                @if (_taskPartialMode == PartialPushMode.Count)
                {
                    <MudItem xs="12"><MudNumericField T="int" @bind-Value="_taskPartialCount" Label="Total random meters" HelperText="Across all selected batches" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" /></MudItem>
                }
                else
                {
                    <MudItem xs="12"><MudNumericField T="double" @bind-Value="_taskPartialPercentage" Label="Random share per batch (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.01" Max="100" /></MudItem>
                }
                <MudItem xs="12"><MudSelect T="int" @bind-SelectedValues="_taskBatches" Label="Batches in selected environment" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">@foreach (MeterBatch b in TaskEnvironmentBatches) { <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType), @b.Count.ToString("N0"))</MudSelectItem> }</MudSelect></MudItem>
            }
            else
            {
                <MudItem xs="12" Style="display:none;">
                    <MudSelect T="int" @bind-SelectedValues="_taskBatches" Label="Expected pull batches" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (MeterBatch b in TaskEnvironmentBatches) { <MudSelectItem T="int" Value="@b.Id">@b.Name (@NicLabel(b.NicType), @b.Count.ToString("N0"))</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                        Monitors inbound TCP sessions during its window. Score weight is 1.3× higher than push tasks.
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=>_taskOpen=false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveTask">@(_taskEditing?"Update":"Add")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<MeterBatch> _batches = Array.Empty<MeterBatch>();
    private IReadOnlyList<TestPlan> _plans = Array.Empty<TestPlan>();
    private IReadOnlyList<TestRunReport> _reports = Array.Empty<TestRunReport>();
    private PushScheduleState _scheduleState = PushScheduleState.Idle;
    private TestRunState? _activeRun;
    private bool _testRunActive;
    private System.Threading.Timer? _timer;
    private readonly HashSet<int> _pushingBatchIds = new();

    // Results
    private List<string> _selectedIds = new(2);
    private readonly HashSet<string> _filterEnvs = new();
    private List<string> _allEnvKeys = new();
    private const int MaxCompare = 5;
    private int _activeTab;                                  // 0 Plans · 1 Results · 2 Push
    private bool ShowLeaderboard => false;
    private bool ShowPlanEnvironmentSelector => false;
    private readonly HashSet<string> _filterPlans = new();   // PlanIds; empty = all
    private List<(string Id, string Name)> _allPlans = new();
    // Environments select the target/broker context. They are not benchmark-score dimensions.
    private bool _showLegacyEnvironmentScores;
    private ScoreMode _leaderboardMode = ScoreMode.Pull;
    private enum ScoreMode { Pull, Push }

    private RenderFragment PlanFilterBar => @<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:22px;">
        @if (_allPlans.Count > 1)
        {
            <span style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--mud-palette-text-secondary);white-space:nowrap;">Plan</span>
            @foreach (var p in _allPlans)
            {
                bool active = _filterPlans.Count == 0 || _filterPlans.Contains(p.Id);
                <span class="env-chip @(active ? "active" : "")" @onclick="@(() => TogglePlanFilter(p.Id))">@p.Name</span>
            }
        }
    </div>;

    // Loop dialog
    private bool _loopOpen;
    private IReadOnlyCollection<int> _loopBatchIds = Array.Empty<int>();
    private int _loopIntervalMin = PushScheduleService.AllowedIntervalMinutes[0];

    // Run dialog
    private bool _runOpen;
    private TestPlan? _runPlan;
    private string _runLabel = "";
    private bool _renameRunOpen;
    private bool _deleteRunOpen;
    private string? _editedRunId;
    private string _editedRunLabel = "";

    // Plan dialog
    private bool _planOpen;
    private bool _editingPlan;
    private bool _editingBase;
    private bool _editingOfficial;
    /// <summary>True while editing an existing plan: its shape is frozen so re-runs stay
    /// apples-to-apples. Only environments and per-job batch selection may change.</summary>
    private bool _planLocked;
    private string? _planId;
    private string _planName = "";
    private IReadOnlyCollection<string> _planEnvs = Array.Empty<string>();
    private List<TestTask> _planTasks = new();
    private string? _planError;

    // Task dialog
    private bool _taskOpen;
    private bool _taskEditing;
    private TestTask? _taskTarget;
    private TestTaskType _taskType = TestTaskType.PushLoop;
    private string _taskLabel = "";
    private int _taskOffset;
    private int _taskDuration = 15;
    private int _taskInterval = 300;
    private int _taskBursts = 3;
    private int? _taskMetersPerBatch;
    private PartialPushMode _taskPartialMode = PartialPushMode.Count;
    private int _taskPartialCount = 1_000;
    private double _taskPartialPercentage = 10;
    private IReadOnlyCollection<int> _taskBatches = Array.Empty<int>();
    private string? _taskEnvironment;
    private IEnumerable<MeterBatch> TaskEnvironmentBatches => string.IsNullOrWhiteSpace(_taskEnvironment)
        ? Enumerable.Empty<MeterBatch>()
        : _batches.Where(batch => string.Equals(batch.EnvironmentKey, _taskEnvironment, StringComparison.OrdinalIgnoreCase));

    private TestPlan? ActivePlan =>
        _activeRun is not null ? _plans.FirstOrDefault(p => p.Id == _activeRun.PlanId) : null;

    protected override void OnInitialized()
    {
        Refresh();
        Schedule.Changed += OnScheduleChanged;
        TestPlans.Changed += OnPlansChanged;
        RunEngine.Changed += OnRunChanged;
        RunEngine.RunCompleted += OnRunCompleted;
        _timer = new System.Threading.Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }), null, 2000, 2000);
    }

    private void Refresh()
    {
        _batches = MeterRegistry.Batches;
        _scheduleState = Schedule.State;
        _plans = TestPlans.Plans;
        _activeRun = RunEngine.ActiveRun;
        _testRunActive = RunEngine.IsActive;
        _reports = RunStore.LoadAll();
        _allEnvKeys = _reports
            .SelectMany(r => r.Environments.Select(e => e.EnvironmentKey))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(k => k).ToList();
        _allPlans = _reports
            .GroupBy(r => r.PlanId)
            .Select(g => (Id: g.Key, Name: g.First().PlanName))
            .OrderBy(p => p.Name).ToList();
    }

    private void OnScheduleChanged() => InvokeAsync(() => { _scheduleState = Schedule.State; StateHasChanged(); });
    private void OnPlansChanged() => InvokeAsync(() => { _plans = TestPlans.Plans; StateHasChanged(); });
    private void OnRunChanged() => InvokeAsync(() => { _activeRun = RunEngine.ActiveRun; _testRunActive = RunEngine.IsActive; StateHasChanged(); });
    private void OnRunCompleted(TestRunReport report) => InvokeAsync(() =>
    {
        _activeRun = RunEngine.ActiveRun; _testRunActive = false;
        Refresh(); StateHasChanged();
        // no auto-download — the report is in Results, download it from there if wanted
        Snackbar.Add($"Run complete — best minute {report.BestMinuteScore:N0} / average {report.AverageMinuteScore:N0}", Severity.Success);
    });

    // Push
    private async Task SendPushAsync(int batchId)
    {
        _pushingBatchIds.Add(batchId);
        try
        {
            if (_editingOfficial && _planTasks.OfType<BurstPushTask>().Any()
                && _planTasks.OfType<BurstPushTask>().SelectMany(t => t.BatchIds).Any(id => _batches.FirstOrDefault(b => b.Id == id)?.Count < 100_000))
            {
                _planError = "Test Push requires selected batches of at least 100,000 meters.";
                return;
            }
            PushBatchResult r = await Push.PushBatchAsync(batchId);
            if (!r.Ok) Snackbar.Add(r.Error ?? "Push failed.", Severity.Error);
            else if (r.Failed == 0) Snackbar.Add($"Pushed {r.Sent}/{r.Total}.", Severity.Success);
            else Snackbar.Add($"Pushed {r.Sent}/{r.Total}; {r.Failed} failed.", Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _pushingBatchIds.Remove(batchId); }
    }

    private void OpenLoopDialog() { _loopBatchIds = _scheduleState.BatchIds.ToList(); _loopIntervalMin = _scheduleState.IntervalMinutes > 0 ? _scheduleState.IntervalMinutes : PushScheduleService.AllowedIntervalMinutes[0]; _loopOpen = true; }
    private void StartLoop() { try { Schedule.Start(_loopBatchIds.ToList(), _loopIntervalMin); _loopOpen = false; } catch (ArgumentException ex) { Snackbar.Add(ex.Message, Severity.Error); } }
    private void StopLoop() { Schedule.Stop(); }

    // Run
    private void OpenRunDialog(TestPlan plan) { _runPlan = plan; _runLabel = ""; _runOpen = true; }
    private void StartRun()
    {
        if (_runPlan is null) return;
        DateTimeOffset at = DateTimeOffset.UtcNow;
        try { RunEngine.ScheduleRun(_runPlan, _runLabel, at); _runOpen = false; Snackbar.Add("Run started.", Severity.Info); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
    private void StopRun() { RunEngine.StopNow(); }
    private void OpenRenameRun(TestRunReport report) { _editedRunId = report.RunId; _editedRunLabel = report.RunLabel; _renameRunOpen = true; }
    private void ConfirmDeleteRun(TestRunReport report) { _editedRunId = report.RunId; _deleteRunOpen = true; }
    private void SaveRunRename()
    {
        if (_editedRunId is null) return;
        if (RunStore.Rename(_editedRunId, _editedRunLabel, out string? error)) { Refresh(); Snackbar.Add("Run renamed.", Severity.Success); }
        else Snackbar.Add(error ?? "Could not rename run.", Severity.Error);
        _renameRunOpen = false;
    }
    private void DeleteRun()
    {
        if (_editedRunId is null) return;
        if (RunStore.Delete(_editedRunId, out string? error))
        {
            _selectedIds.Remove(_editedRunId);
            Refresh();
            Snackbar.Add("Run deleted.", Severity.Success);
        }
        else Snackbar.Add(error ?? "Could not delete run.", Severity.Error);
        _deleteRunOpen = false;
    }

    // Plans
    private void OpenAddPlan() { _editingPlan = false; _editingBase = false; _editingOfficial = false; _planLocked = false; _planId = null; _planName = ""; _planEnvs = Array.Empty<string>(); _planTasks = new(); _planError = null; _planOpen = true; }
    private void OpenEditPlan(TestPlan p) { _editingPlan = true; _editingBase = p.IsBasePlan; _editingOfficial = p.IsOfficial; _planLocked = true; _planId = p.Id; _planName = p.Name; _planEnvs = p.EnvironmentKeys.ToList(); _planTasks = p.Tasks.ToList(); _planError = null; _planOpen = true; }

    private void SavePlan()
    {
        _planError = null;
        _planEnvs = _planTasks.Where(t => t.Type is TestTaskType.PushLoop or TestTaskType.BurstPush or TestTaskType.PartialPush)
            .Select(t => t.EnvironmentKey).Where(key => !string.IsNullOrWhiteSpace(key)).Select(key => key!).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
        if (!_editingBase && string.IsNullOrWhiteSpace(_planName)) { _planError = "Name is required."; return; }
        if (_planEnvs.Count > 1) { _planError = "All push tasks in a plan must use the same environment."; return; }
        if (_editingBase && _planId == TestPlanRegistry.PushPlanId && _planEnvs.Count != 1) { _planError = "Test Push requires exactly one environment."; return; }
        try
        {
            if (_editingPlan && _planId is not null)
            {
                TestPlan? ex = TestPlans.Plan(_planId);
                if (ex is null) { _planError = "Not found."; return; }
                TestPlans.UpdatePlan(new TestPlan { Id = ex.Id, Name = _editingBase ? ex.Name : _planName, IsBasePlan = ex.IsBasePlan, OfficialKind = ex.OfficialKind, EnvironmentKeys = _planEnvs.ToList(), Tasks = _planTasks.ToList(), LockedFields = ex.LockedFields, CreatedAtUtc = ex.CreatedAtUtc });
            }
            else
            {
                TestPlans.AddPlan(new TestPlan { Name = _planName, EnvironmentKeys = _planEnvs.ToList(), Tasks = _planTasks.ToList() });
            }
            _planOpen = false;
        }
        catch (ArgumentException ex) { _planError = ex.Message; }
    }

    private void DeletePlan(TestPlan p) { if (!TestPlans.DeletePlan(p.Id, out string e)) Snackbar.Add(e, Severity.Error); }

    // Tasks
    private void OpenAddTask() { _taskEditing = false; _taskTarget = null; _taskType = TestTaskType.PushLoop; _taskLabel = ""; _taskOffset = 0; _taskDuration = 15; _taskInterval = 300; _taskBursts = 3; _taskMetersPerBatch = null; _taskPartialMode = PartialPushMode.Count; _taskPartialCount = 1_000; _taskPartialPercentage = 10; _taskBatches = Array.Empty<int>(); _taskEnvironment = null; _taskOpen = true; }
    private void OpenEditTask(TestTask t) { _taskEditing = true; _taskTarget = t; _taskType = t.Type; _taskLabel = t.Label; _taskOffset = t.OffsetMinutes; _taskDuration = t.DurationMinutes; _taskInterval = t is PushLoopTask pl ? pl.PushIntervalSec : 300; _taskBursts = t is BurstPushTask bt ? bt.BurstCount : t is PartialPushTask pt ? pt.BurstCount : 3; _taskMetersPerBatch = t is BurstPushTask standard ? standard.MetersPerBatch : null; _taskPartialMode = t is PartialPushTask partial ? partial.Mode : PartialPushMode.Count; _taskPartialCount = t is PartialPushTask partialCount ? partialCount.MeterCount : 1_000; _taskPartialPercentage = t is PartialPushTask partialPercent ? partialPercent.Percentage : 10; _taskBatches = t is PushLoopTask pl2 ? pl2.BatchIds.ToList() : t is BurstPushTask bt2 ? bt2.BatchIds.ToList() : t is PartialPushTask pt2 ? pt2.BatchIds.ToList() : Array.Empty<int>(); _taskEnvironment = t.EnvironmentKey; _taskOpen = true; }

    private void SaveTask()
    {
        TestTask n = _taskType switch
        {
            TestTaskType.PushLoop => new PushLoopTask { Label = _taskLabel, OffsetMinutes = _taskOffset, DurationMinutes = _taskDuration, PushIntervalSec = _taskInterval, BatchIds = _taskBatches.ToList(), EnvironmentKey = _taskEnvironment },
            TestTaskType.BurstPush => new BurstPushTask { Label = _taskLabel, OffsetMinutes = _taskOffset, DurationMinutes = _taskDuration, BurstCount = _taskBursts, BatchIds = _taskBatches.ToList(), MetersPerBatch = _taskMetersPerBatch, EnvironmentKey = _taskEnvironment },
            TestTaskType.PartialPush => new PartialPushTask { Label = _taskLabel, OffsetMinutes = _taskOffset, DurationMinutes = _taskDuration, BurstCount = _taskBursts, BatchIds = _taskBatches.ToList(), Mode = _taskPartialMode, MeterCount = _taskPartialCount, Percentage = _taskPartialPercentage, EnvironmentKey = _taskEnvironment },
            _ => new PullListenerTask { Label = _taskLabel, OffsetMinutes = _taskOffset, DurationMinutes = _taskDuration, BatchIds = new List<int>() },
        };
        if (_taskEditing && _taskTarget is not null) { int i = _planTasks.IndexOf(_taskTarget); if (i >= 0) _planTasks[i] = n; }
        else _planTasks.Add(n);
        _taskOpen = false;
    }

    private Task OnTaskEnvironmentChanged(string? environmentKey)
    {
        _taskEnvironment = environmentKey;
        _taskBatches = _taskBatches.Where(id => _batches.Any(batch => batch.Id == id && string.Equals(batch.EnvironmentKey, environmentKey, StringComparison.OrdinalIgnoreCase))).ToArray();
        return Task.CompletedTask;
    }


    private void ToggleSelect(string id)
    {
        if (_selectedIds.Contains(id)) { _selectedIds.Remove(id); return; }
        if (_selectedIds.Count >= MaxCompare) _selectedIds.RemoveAt(0);   // oldest drops out
        _selectedIds.Add(id);
    }


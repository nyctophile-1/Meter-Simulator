@page "/faqs"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>MAYA - FAQs</PageTitle>

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Frequently asked questions about the simulator. (Placeholder content &mdash; to be replaced.)
</MudText>

<MudStack Spacing="4" Style="max-width:860px;">
    @foreach ((string question, string answer) in Items)
    {
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">@question</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">@answer</MudText>
        </MudPaper>
    }
</MudStack>

@code {
    // Placeholder Q&A — swap the text for the real questions/answers later.
    private static readonly (string Question, string Answer)[] Items =
    {
        ("What is MAYA - Many-Meter Simulator?",
         "It emulates a large fleet of TCP smart meters, allowing a Head-End System to be tested at scale without physical hardware."),
        ("How to use this Simulator?",
         "Create a batch using your own meter template xml file. Download csv and register meters to HES. Run commands."),
        ("What is meter template xml? How to get it?",
         "Template xml contains all the capture objects, bufferes, etc of a meter. Connect meter with desired firmware with GURUX and use “Save Values AS” to generate the xml file."),
        ("Why do we need an Internal Simulator?",
         "“A company’s greatness is defined by the quality of its Simulators.”"),
        ("How many meters can it simulate?",
         "Don't ask any more questions. Thank you."),
        ("Is it better than Kalki's Million meter simulator?",
         "No. But, it was made with Passion."),
        ("Is it worse than Kalki's Million meter simulator?",
         "पहले इस्तेमाल करें फिर विश्वास करें. Don't reject without checking."),
        ("When to expect other features in this simulator like push, outages, events etc.?",
         "First go look at prod meters and its SLA breaches. This sim is for load testing and not to replicate real world scenarios yet. QA will share what features are needed for them to load test, only those features will be implemented."),
    };
}

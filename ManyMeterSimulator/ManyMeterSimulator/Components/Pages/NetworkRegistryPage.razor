@page "/network"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ManyMeterSimulator.Auth
@using ManyMeterSimulator.Networking.Mqtt
@using ManyMeterSimulator.Networking.Nic
@using ManyMeterSimulator.Networking.Registry
@using ManyMeterSimulator.Provisioning
@inject NetworkRegistry Network
@inject MeterRegistry MeterRegistry
@inject EndpointProber Prober
@inject NetworkHealthMonitor Health
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>MAYA - Environments</PageTitle>

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    HES environments: each combines an MQTT broker and a TCP push listener into one entry that
    batches bind to. An environment is only accepted once we have connected to at least one of its
    halves. Health refreshes every @Health.IntervalSeconds s.
</MudText>

@if (IsAdmin)
{
    <div class="d-flex align-center flex-wrap mb-4" style="gap:8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddCircleOutline" OnClick="OpenAddEnvironment">Add environment</MudButton>
    </div>
}

<MudText Typo="Typo.h6" Class="mb-2">Environments (@Environments.Count)</MudText>

@if (Environments.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
        None yet. Batches cannot reach a network until an environment exists.
    </MudText>
}
else
{
    <MudSimpleTable Hover="true" Dense="true" Bordered="false" Class="batch-table mb-6">
        <thead>
            <tr>
                <th>Name / Key</th>
                <th>TCP push</th>
                <th>MQTT broker</th>
                <th>State</th>
                <th>Last verified</th>
                <th style="text-align:right">Used by</th>
                @if (CanOperate)
                {
                    <th style="text-align:right">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (HesEnvironment env in Environments)
            {
                EndpointHealth health = Health.For(env.Key);
                <tr class="batch-row @HealthRowClass(env.Enabled, health)">
                    <td>
                        <span><strong>@env.DisplayName</strong></span>
                        @if (!string.IsNullOrWhiteSpace(env.Name))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block"><code>@env.Key</code></MudText>
                        }
                    </td>
                    <td>
                        @if (env.HasTcp)
                        {
                            <code style="color:@HalfColor(health)">@env.TcpHost:@env.TcpPort</code>
                        }
                        else
                        {
                            <span class="mud-text-secondary">&mdash;</span>
                        }
                    </td>
                    <td>
                        @if (env.HasBroker)
                        {
                            <span style="color:@HalfColor(health)">@env.BrokerHost:@env.BrokerPort</span>
                            @if (env.BrokerUseTls)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1">TLS</MudChip>
                            }
                            @if (!string.IsNullOrEmpty(env.BrokerUsername))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">user @env.BrokerUsername</MudText>
                            }
                        }
                        else
                        {
                            <span class="mud-text-secondary">&mdash;</span>
                        }
                    </td>
                    <td>@StateCell(env.Enabled, env.Verified, health)</td>
                    <td>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Ago(health.CheckedUtc)</MudText>
                    </td>
                    <td style="text-align:right">@MeterRegistry.BatchesUsingEnvironment(env.Key).Count</td>
                    @if (CanOperate)
                    {
                        <td style="text-align:right">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       Disabled="@_testing.Contains(env.Key)"
                                       OnClick="() => TestEnvironmentAsync(env)">Test</MudButton>
                            @if (IsAdmin)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                                           OnClick="() => OpenEditEnvironment(env)">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="ml-1"
                                           OnClick="() => ToggleEnvironment(env)">
                                    @(env.Enabled ? "Disable" : "Enable")
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" Class="ml-1"
                                           OnClick="() => DeleteEnvironmentAsync(env)">Delete</MudButton>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@* ---------- Add / Edit environment dialog ---------- *@
<MudDialog @bind-Visible="_envDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingEnv ? "Edit environment" : "Add environment")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            An environment pairs an MQTT broker and a TCP push listener. Either half may be left
            blank. We test each configured half before saving; a key cannot be renamed after creation.
            @if (_editingEnv)
            {
                <text> Leave the broker password blank to keep the stored one.</text>
            }
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_envKey" Immediate="true" Label="Key"
                              Placeholder="e.g. pune-hes" Variant="Variant.Outlined"
                              Disabled="@_editingEnv"
                              Error="@(!_editingEnv && _envKey.Length > 0 && !Network.IsKeyAvailable(_envKey))"
                              ErrorText="That key is already taken." />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_envName" Label="Display name (optional)"
                              Placeholder="e.g. Pune HES Primary" Variant="Variant.Outlined" />
            </MudItem>

            @* TCP push section *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-1">TCP push endpoint</MudText>
            </MudItem>
            <MudItem xs="8">
                <MudTextField T="string" @bind-Value="_tcpHost" Immediate="true" Label="IPv6 address"
                              Placeholder="fd00::1 (blank = not configured)" Variant="Variant.Outlined"
                              Error="@(_tcpHost.Length > 0 && !TcpAddressLooksValid)"
                              ErrorText="@TcpAddressError" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_tcpPort" Min="1" Max="65535" Label="Port"
                                 Variant="Variant.Outlined" />
            </MudItem>

            @* MQTT broker section *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-1">MQTT broker</MudText>
            </MudItem>
            <MudItem xs="8">
                <MudTextField T="string" @bind-Value="_brokerHost" Immediate="true" Label="Host"
                              Placeholder="10.0.0.1 or broker.example.com (blank = not configured)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField T="int" @bind-Value="_brokerPort" Min="1" Max="65535" Label="Port"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="string" @bind-Value="_brokerUser" Label="Username"
                              HelperText="Leave blank for anonymous" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6">
                <MudTextField T="string" @bind-Value="_brokerPassword" Label="Password"
                              InputType="InputType.Password" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch T="bool" @bind-Value="_brokerTls" Color="Color.Primary" Label="Use TLS" />
            </MudItem>
        </MudGrid>

        @if (_dialogError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-3"
                      Style="word-break:break-word;overflow-wrap:anywhere;">
                @_dialogError
            </MudAlert>
            @if (IsAdmin)
            {
                <MudCheckBox T="bool" @bind-Value="_saveUnverified" Color="Color.Warning" Dense="true"
                             Label="Save anyway, unverified" Class="mt-1" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _envDialogOpen = false)" Disabled="@_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || !CanSaveEnvironment)"
                   OnClick="SaveEnvironmentAsync">
            @(_saving ? "Testing…" : _saveUnverified ? "Save unverified" : "Test and save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ClaimsPrincipal? _user;
    private Timer? _refresh;

    private bool IsAdmin => _user?.IsInRole(AppRoles.Admin) ?? false;
    private bool CanOperate => _user?.IsInRole(AppRoles.Utility) ?? false;

    private IReadOnlyList<HesEnvironment> Environments => Network.Environments;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private readonly HashSet<string> _testing = new(StringComparer.OrdinalIgnoreCase);

    private bool _envDialogOpen, _saving, _saveUnverified;
    private bool _editingEnv;
    private string? _dialogError;

    // Form state
    private string _envKey = "", _envName = "";
    private string _tcpHost = "";
    private int _tcpPort = 4059;
    private string _brokerHost = "", _brokerUser = "", _brokerPassword = "";
    private int _brokerPort = 1883;
    private bool _brokerTls;

    private bool CanSaveEnvironment =>
        _envKey.Trim().Length > 0
        && (_editingEnv || Network.IsKeyAvailable(_envKey.Trim()))
        && (_tcpHost.Length == 0 || TcpAddressLooksValid)
        && (_tcpHost.Length > 0 || _brokerHost.Trim().Length > 0);

    private bool TcpAddressLooksValid =>
        PushTargetEndpoint.TryParseAddress(_tcpHost, out _, out _);

    private string TcpAddressError
    {
        get
        {
            PushTargetEndpoint.TryParseAddress(_tcpHost, out _, out string error);
            return error;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            AuthenticationState state = await AuthStateTask;
            _user = state.User;
        }

        _refresh = new Timer(
            _ => InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(5),
            TimeSpan.FromSeconds(5));
    }

    public void Dispose() => _refresh?.Dispose();

    private void OpenAddEnvironment()
    {
        if (!IsAdmin) return;

        _editingEnv = false;
        _envKey = _envName = _tcpHost = _brokerHost = _brokerUser = _brokerPassword = "";
        _tcpPort = 4059;
        _brokerPort = 1883;
        _brokerTls = false;
        _dialogError = null;
        _saveUnverified = false;
        _envDialogOpen = true;
    }

    private void OpenEditEnvironment(HesEnvironment env)
    {
        if (!IsAdmin) return;

        _editingEnv = true;
        _envKey = env.Key;
        _envName = env.Name;
        _tcpHost = env.TcpHost;
        _tcpPort = env.TcpPort;
        _brokerHost = env.BrokerHost;
        _brokerPort = env.BrokerPort;
        _brokerUser = env.BrokerUsername;
        _brokerPassword = "";   // never round-trip the password
        _brokerTls = env.BrokerUseTls;
        _dialogError = null;
        _saveUnverified = false;
        _envDialogOpen = true;
    }

    private async Task SaveEnvironmentAsync()
    {
        if (!IsAdmin) return;

        HesEnvironment? existing = _editingEnv ? Network.Environment(_envKey) : null;

        var env = new HesEnvironment
        {
            Key = _envKey.Trim(),
            Name = _envName.Trim(),
            TcpHost = _tcpHost.Trim().Trim('[', ']'),
            TcpPort = _tcpPort,
            BrokerHost = _brokerHost.Trim(),
            BrokerPort = _brokerPort,
            BrokerUsername = _brokerUser.Trim(),
            BrokerPassword = _brokerPassword.Length > 0 ? _brokerPassword : existing?.BrokerPassword ?? "",
            BrokerUseTls = _brokerTls,
            CreatedAtUtc = existing?.CreatedAtUtc ?? DateTimeOffset.UtcNow,
        };

        _saving = true;
        _dialogError = null;
        try
        {
            bool verified = false;
            if (!_saveUnverified)
            {
                // Test whichever halves are configured.
                if (env.HasBroker)
                {
                    var brokerEndpoint = new BrokerEndpoint
                    {
                        Key = env.Key,
                        Host = env.BrokerHost,
                        Port = env.BrokerPort,
                        Username = env.BrokerUsername,
                        Password = env.BrokerPassword,
                        UseTls = env.BrokerUseTls,
                    };
                    ProbeResult probe = await Prober.TestBrokerAsync(brokerEndpoint);
                    if (!probe.Ok)
                    {
                        _dialogError = probe.Error;
                        return;
                    }
                    verified = true;
                }

                if (env.HasTcp)
                {
                    var pushEndpoint = new PushTargetEndpoint
                    {
                        Key = env.Key,
                        Address = env.TcpHost,
                        Port = env.TcpPort,
                    };
                    ProbeResult probe = await Prober.TestPushTargetAsync(pushEndpoint);
                    if (!probe.Ok)
                    {
                        _dialogError = probe.Error;
                        return;
                    }
                    verified = true;
                }
            }

            if (_editingEnv)
            {
                Network.UpdateEnvironment(env, verified);
            }
            else
            {
                Network.AddEnvironment(env, verified);
            }

            Health.Record(env.Key, verified, verified ? null : "saved without a successful connection");
            _envDialogOpen = false;
            Snackbar.Add(
                verified ? $"Environment '{env.Key}' verified and saved." : $"Environment '{env.Key}' saved UNVERIFIED.",
                verified ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _dialogError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestEnvironmentAsync(HesEnvironment env)
    {
        if (!CanOperate) return;

        _testing.Add(env.Key);
        try
        {
            bool anyOk = false;
            string? lastError = null;

            if (env.HasBroker)
            {
                var brokerEndpoint = new BrokerEndpoint
                {
                    Key = env.Key,
                    Host = env.BrokerHost,
                    Port = env.BrokerPort,
                    Username = env.BrokerUsername,
                    Password = env.BrokerPassword,
                    UseTls = env.BrokerUseTls,
                };
                ProbeResult probe = await Prober.TestBrokerAsync(brokerEndpoint);
                if (probe.Ok) anyOk = true;
                else lastError = $"Broker: {probe.Error}";
            }

            if (env.HasTcp)
            {
                var pushEndpoint = new PushTargetEndpoint
                {
                    Key = env.Key,
                    Address = env.TcpHost,
                    Port = env.TcpPort,
                };
                ProbeResult probe = await Prober.TestPushTargetAsync(pushEndpoint);
                if (probe.Ok) anyOk = true;
                else lastError = $"TCP: {probe.Error}";
            }

            Health.Record(env.Key, anyOk, anyOk ? null : lastError);
            Network.RecordEnvironmentReachable(env.Key);
            Snackbar.Add(
                anyOk ? $"{env.Key}: reachable." : $"{env.Key}: {lastError}",
                anyOk ? Severity.Success : Severity.Error);
        }
        finally
        {
            _testing.Remove(env.Key);
        }
    }

    private void ToggleEnvironment(HesEnvironment env)
    {
        if (!IsAdmin) return;

        Network.SetEnvironmentEnabled(env.Key, !env.Enabled);
        Snackbar.Add(
            env.Enabled
                ? $"'{env.Key}' disabled."
                : $"'{env.Key}' enabled.",
            Severity.Info);
    }

    private async Task DeleteEnvironmentAsync(HesEnvironment env)
    {
        if (!IsAdmin) return;

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete environment?",
            $"Permanently delete \"{env.Key}\" ({env.Describe()})? Any batch bound to it must be " +
            "rebound first. This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true) return;

        if (!Network.TryDeleteEnvironment(env.Key, out string error))
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    // ── Presentation ─────────────────────────────────────────────────────────────────────────

    private RenderFragment StateCell(bool enabled, bool verified, EndpointHealth health) => builder =>
    {
        (string label, Color color) = (enabled, verified, health.Ok) switch
        {
            (false, _, _) => ("Disabled", Color.Default),
            (true, false, null) => ("Unverified", Color.Warning),
            (true, _, true) => ("Connected", Color.Success),
            (true, _, false) => ("Unreachable", Color.Error),
            _ => ("Checking…", Color.Default),
        };

        builder.OpenComponent<MudChip<string>>(0);
        builder.AddAttribute(1, "Size", Size.Small);
        builder.AddAttribute(2, "Variant", Variant.Filled);
        builder.AddAttribute(3, "Color", color);
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(b => b.AddContent(0, label)));
        builder.CloseComponent();

        if (health is { Ok: false, Error: not null })
        {
            builder.OpenComponent<MudText>(5);
            builder.AddAttribute(6, "Typo", Typo.caption);
            builder.AddAttribute(7, "Class", "mud-text-secondary d-block");
            builder.AddAttribute(8, "Style", "word-break:break-all;overflow-wrap:anywhere;max-width:260px;");
            builder.AddAttribute(9, "ChildContent", (RenderFragment)(b => b.AddContent(0, health.Error)));
            builder.CloseComponent();
        }
    };

    private static string HalfColor(EndpointHealth health) => health.Ok switch
    {
        true => "var(--mud-palette-success)",
        false => "var(--mud-palette-error)",
        _ => "inherit",
    };

    private static string HealthRowClass(bool enabled, EndpointHealth health) =>
        !enabled ? "is-idle" : health.Ok switch
        {
            true => "is-running",
            false => "is-stopped",
            null => "is-idle",
        };

    private static string Ago(DateTimeOffset? when)
    {
        if (when is null) return "never";

        TimeSpan since = DateTimeOffset.UtcNow - when.Value;
        return since switch
        {
            { TotalSeconds: < 60 } => $"{since.TotalSeconds:F0}s ago",
            { TotalMinutes: < 60 } => $"{since.TotalMinutes:F0}m ago",
            _ => $"{since.TotalHours:F0}h ago",
        };
    }
}

@page "/batches"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ManyMeterSimulator.Auth
@using ManyMeterSimulator.Brain
@using ManyMeterSimulator.Networking.Nic
@using ManyMeterSimulator.Networking.Registry
@using Microsoft.AspNetCore.Components.Forms
@inject MeterRegistry MeterRegistry
@inject NetworkRegistry Network
@inject NetworkBindingValidator Bindings
@inject NetworkHealthMonitor Health
@inject TemplateRegistry TemplateRegistry
@inject MeterSessionManager Sessions
@inject ConfigBundleService ConfigBundles
@inject IOptions<TcpOptions> TcpOptionsAccessor
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NetworkDelaySettings NetworkDelay
@inject IJSRuntime JS

<PageTitle>MAYA - Batch Setup</PageTitle>

@* Network delay is deliberately absent here — it lives on the BadComm page with the other
   field-condition knobs, so there is only one place to read or change it. *@
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    TCP address prefix: <code>@AddressPrefix</code> &middot; max supported meters:
    <code>@MeterRegistry.MaxIndex.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</code>
    &middot; every meter has a node id whatever its NIC; only 4G TCP meters also get an IP
</MudText>
@if (IsAdmin)
{
    <div class="d-flex align-center flex-wrap mb-4" style="gap:8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _addBatchOpen = true)">Add Batch</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="@(() => _uploadOpen = true)">Upload Meter Model</MudButton>

        <MudSpacer />

        @* Batches only — identity, not per-meter rows. Migrating a fleet whole? Import the network
           file first so bindings resolve as batches land. *@
        <MudButton Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Download" OnClick="ExportBatches">
            Export batches
        </MudButton>
        @* Native InputFile + label-for: MudFileUpload's ActivatorContent slot does not bind in 9.7. *@
        <InputFile id="batches-import-input" OnChange="OnBatchesFileSelected" accept=".json" class="d-none" />
        <MudButton HtmlTag="label" for="batches-import-input" Variant="Variant.Outlined" Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Upload">
            Import batches
        </MudButton>
    </div>
}

@* ══════════ Add Batch Dialog ══════════ *@
<MudDialog @bind-Visible="_addBatchOpen" Options="_addBatchDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Provision a new batch</MudText></TitleContent>
    <DialogContent>
        <MudGrid Spacing="3" Class="mt-1">
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="BatchName" Immediate="true"
                              Label="Batch name" Placeholder="e.g. batch-1"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="MeterCount" Immediate="true" Min="1"
                                 Label="Number of meters (N)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="SelectedTemplate" Label="Meter model (XML)"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (string t in Templates)
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="NicType" @bind-Value="SelectedNic" Label="NIC"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (NicType nic in AllNics)
                    {
                        <MudSelectItem Value="@nic">@NicLabel(nic)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int?" @bind-Value="HesTemplateId" Immediate="true" Min="1"
                                 Label="HES template id"
                                 Placeholder="e.g. 122"
                                 Disabled="@(!NeedsHesTemplateId(SelectedNic))"
                                 HelperText="@(NeedsHesTemplateId(SelectedNic)
                                     ? "Optional — needed only for the custom channel"
                                     : "Wirepas only")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="SelectedBroker" Label="MQTT broker"
                           Disabled="@(!NicTypes.IsMqtt(SelectedNic))"
                           HelperText="@(NicTypes.IsMqtt(SelectedNic)
                               ? "Unbound meters are never reached"
                               : "TCP is broker-agnostic")"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@UnboundOption">(none — unbound)</MudSelectItem>
                    @foreach (BrokerEndpoint b in Network.Brokers)
                    {
                        <MudSelectItem T="string" Value="@b.Key">@b.Key@(b.Enabled ? "" : " (disabled)")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="SelectedPushTarget" Label="HES push target"
                           Disabled="@(SelectedNic != NicType.Tcp4G)"
                           HelperText="@(SelectedNic == NicType.Tcp4G
                               ? "Only needed for push; pulls work regardless"
                               : "4G TCP only")"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@UnboundOption">(none — unbound)</MudSelectItem>
                    @foreach (PushTargetEndpoint t in Network.PushTargets)
                    {
                        <MudSelectItem T="string" Value="@t.Key">@t.Key@(t.Enabled ? "" : " (disabled)")</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (MeterCount > 0)
        {
            BatchPreview preview = MeterRegistry.PreviewNextBatch(AddressPrefix, MeterCount);
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                Will reserve node ids <code>@preview.FirstNodeId</code> &ndash; <code>@preview.LastNodeId</code>
                &middot; meter numbers <code>@preview.FirstSerial</code> &ndash; <code>@preview.LastSerial</code>
                @if (SelectedNic == NicType.Tcp4G)
                {
                    <text>&middot; IPs <code>@preview.FirstAddress</code> &ndash; <code>@preview.LastAddress</code></text>
                }
                (@MeterCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) meter(s))
            </MudAlert>
        }

        @if (ErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@ErrorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addBatchOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddBatchFromDialog"
                   Disabled="@(MeterCount <= 0 || string.IsNullOrWhiteSpace(BatchName) || string.IsNullOrWhiteSpace(SelectedTemplate))">
            Add Batch
        </MudButton>
    </DialogActions>
</MudDialog>

@* ══════════ Upload Meter Model Dialog ══════════ *@
<MudDialog @bind-Visible="_uploadOpen" Options="_uploadDialogOptions">
    <TitleContent><MudText Typo="Typo.h6">Meter Model XML</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Upload new DLMS/COSEM meter model XML files. Files uploaded here are saved directly to the models folder on the server and are instantly available for selection when provisioning batches.
        </MudText>

        <MudFileUpload T="IBrowserFile" Accept=".xml" FilesChanged="OnTemplateUpload" MaximumFileCount="1" Class="ma-0">
            <ActivatorContent>
                <MudButton HtmlTag="label"
                           Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.CloudUpload">
                    Upload Meter Model XML
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (UploadMessage is not null)
        {
            <MudAlert Severity="@(UploadMessage.Contains("failed") ? Severity.Error : Severity.Success)" Dense="true" Class="mt-3">
                @UploadMessage
            </MudAlert>
        }

        <div style="height: 1px; background: rgba(255, 255, 255, 0.08); margin: 1rem 0; flex-shrink: 0;"></div>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Available Meter Models on Server:</MudText>
        @if (Templates.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
                No meter models found on the server. Please upload a meter model XML file to get started.
            </MudAlert>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (string t in Templates)
                {
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
                        @t
                    </MudChip>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _uploadOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<div class="d-flex align-center justify-space-between mb-2" style="gap:12px;">
    <MudText Typo="Typo.h6" Class="mb-0">Batches (@MeterRegistry.Batches.Count)</MudText>
    <div class="d-flex align-center" style="gap:8px;">
        @if (MeterRegistry.Batches.Count > 0)
        {
            @* Any authenticated user can export, same as the per-batch download. *@
            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAllCsv">
                Download all meters
            </MudButton>
        }
        @if (IsAdmin && MeterRegistry.Batches.Count > 0)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAll">Reset all batches</MudButton>
        }
    </div>
</div>

@{
    IReadOnlyList<MeterBatch> batches = MeterRegistry.Batches;
}
@if (batches.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">None yet.</MudText>
}
else
{
    @* Only identity and state are on the row. The model, node-id / IP / meter-number ranges are
       reference detail — needed when registering meters with the HES, not when scanning the list
       — so they move into an expandable panel and stop forcing every range onto three lines. *@
    <MudSimpleTable Hover="true" Dense="true" Bordered="false" Class="batch-table">
        <thead>
            <tr>
                <th>NIC</th>
                @* Absorbs all the slack, so the remaining columns stay grouped instead of
                   drifting apart into voids on a wide screen. *@
                <th class="col-flex">Name</th>
                @* Where this batch talks, and whether that endpoint is up — the two questions the
                   detail panel used to hide one click away. *@
                <th>Comm</th>
                <th style="text-align:right">Count</th>
                <th>Status</th>
                @if (CanOperate)
                {
                    <th style="text-align:right">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (MeterBatch batch in batches)
            {
                bool expanded = ExpandedBatches.Contains(batch.Id);
                (string firstNode, string lastNode) = MeterRegistry.GetNodeIdRange(batch);
                @* The whole row is the hit target — no chevron; the row itself is the affordance,
                   with the open state shown by its background. Cells holding their own controls
                   stop propagation so Start/Stop/Delete do not also toggle the panel. *@
                <tr class="batch-row @StatusRowClass(batch.Status) @(expanded ? "is-expanded" : "")"
                    @onclick="() => ToggleDetails(batch.Id)">
                    <td>
                        <span class="nic-badge nic-badge-@batch.NicType.ToString().ToLowerInvariant()">@NicLabel(batch.NicType)</span>
                        @if (batch.HesTemplateId is int hesId)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">tpl @hesId</MudText>
                        }
                    </td>
                    <td class="col-flex">
                        @batch.Name
                        @if (NetworkBindingValidator.IsUnreachable(batch))
                        {
                            @* Running and bound to nothing: it answers no one, and silence is the
                               only other symptom. *@
                            <MudTooltip Text="Running but bound to no broker — its meters are never reached.">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                         Class="ml-2">unreachable</MudChip>
                            </MudTooltip>
                        }
                    </td>
                    <td>
                        @{
                            (string commLabel, string commColor, string commTitle) = Comm(batch);
                        }
                        @* Label wrapped so it can ellipsize — a bare text node cannot. *@
                        <span class="batch-comm" title="@commTitle">
                            <span class="legend-dot" style="background:@commColor;"></span><span>@commLabel</span>
                        </span>
                    </td>
                    <td style="text-align:right">@batch.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(batch.Status)">
                            @batch.Status
                        </MudChip>
                    </td>
                    @if (CanOperate)
                    {
                        <td style="text-align:right" @onclick:stopPropagation="true">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="() => Start(batch.Id)" Disabled="@(batch.Status == BatchStatus.Running)">Start</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Class="ml-1"
                                       OnClick="() => Stop(batch.Id)" Disabled="@(batch.Status == BatchStatus.Stopped)">Stop</MudButton>
                            @if (IsAdmin)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" Class="ml-1"
                                           OnClick="() => Delete(batch.Id)">Delete</MudButton>
                            }
                        </td>
                    }
                </tr>
                @if (expanded)
                {
                    @* The panel is part of the same hit target as the row above it: clicking
                       anywhere in it closes the batch again, so the open state has one obvious way
                       out instead of forcing a trip back to the header row. Controls inside stop
                       propagation. *@
                    <tr class="batch-detail-row @StatusRowClass(batch.Status)"
                        @onclick="() => ToggleDetails(batch.Id)">
                        <td colspan="@(CanOperate ? 6 : 5)" class="pa-0">
                            <div class="batch-detail">
                                @* One CSS grid for every field, so the label/value rhythm is identical
                                   across them and the panel does not need per-item margins. Replaced
                                   MudGrid, whose 12-column items reflowed into a ragged block once a
                                   fifth field was added. *@
                                <div class="batch-detail-grid">
                                    <div class="batch-detail-field">
                                        <span class="batch-detail-label">Meter model</span>
                                        <code>@batch.TemplateName</code>
                                    </div>
                                    <div class="batch-detail-field">
                                        <span class="batch-detail-label">Node id range</span>
                                        <code>@firstNode &ndash; @lastNode</code>
                                    </div>
                                    <div class="batch-detail-field">
                                        <span class="batch-detail-label">Meter# range</span>
                                        <code>@MeterRegistry.FormatSerial(batch.StartIndex) &ndash; @MeterRegistry.FormatSerial(batch.EndIndex)</code>
                                    </div>
                                    <div class="batch-detail-field">
                                        <span class="batch-detail-label">IP range</span>
                                        @if (batch.NicType == NicType.Tcp4G)
                                        {
                                            (IPAddress firstAddr, IPAddress lastAddr) = MeterRegistry.GetAddressRange(batch, AddressPrefix);
                                            <code>@firstAddr &ndash; @lastAddr</code>
                                        }
                                        else
                                        {
                                            @* Only 4G TCP meters get an IP; the rest are reached by node id. *@
                                            <span class="mud-text-secondary">&mdash; not applicable on @NicLabel(batch.NicType)</span>
                                        }
                                    </div>
                                    @* The binding NAME is on the row above now, so this shows the part
                                       the row cannot: where that endpoint actually points. *@
                                    <div class="batch-detail-field">
                                        <span class="batch-detail-label">Network binding</span>
                                        <code>@BindingDetail(batch)</code>
                                    </div>
                                </div>

                                @* Buttons stop propagation: the panel itself collapses on click, and
                                   an action inside it must not do both. *@
                                <div class="batch-detail-actions" @onclick:stopPropagation="true">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.Download"
                                               OnClick="() => DownloadCsv(batch.Id)">
                                        Download meter list (CSV)
                                    </MudButton>
                                    @if (IsAdmin)
                                    {
                                        @* Admin-only: rebinding redirects live traffic for every meter
                                           in the batch, so it sits with provisioning, not operation. *@
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   StartIcon="@Icons.Material.Filled.Hub"
                                                   OnClick="() => OpenRebind(batch)">
                                            Change network binding
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
}

@* ---------- Rebind dialog (admin only) ---------- *@
<MudDialog @bind-Visible="_rebindOpen" Options="_rebindOptions">
    <TitleContent><MudText Typo="Typo.h6">Network binding &mdash; @_rebindBatch?.Name</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Takes effect immediately: an MQTT batch's traffic moves to the new broker on the next
            reconcile, with no restart. Choose <em>(none)</em> to leave it connected to nothing.
        </MudText>
        @if (_rebindBatch is not null && NicTypes.IsMqtt(_rebindBatch.NicType))
        {
            <MudSelect T="string" @bind-Value="_rebindBroker" Label="MQTT broker" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@UnboundOption">(none — unbound)</MudSelectItem>
                @foreach (BrokerEndpoint b in Network.Brokers)
                {
                    <MudSelectItem T="string" Value="@b.Key">@b.Key@(b.Enabled ? "" : " (disabled)")</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudSelect T="string" @bind-Value="_rebindPushTarget" Label="HES push target" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@UnboundOption">(none — unbound)</MudSelectItem>
                @foreach (PushTargetEndpoint t in Network.PushTargets)
                {
                    <MudSelectItem T="string" Value="@t.Key">@t.Key@(t.Enabled ? "" : " (disabled)")</MudSelectItem>
                }
            </MudSelect>
        }

        @if (_rebindError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-3">@_rebindError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _rebindOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRebind">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ClaimsPrincipal? _user;

    private string BatchName { get; set; } = "";
    private int MeterCount { get; set; } = 100;
    private string SelectedTemplate { get; set; } = "";
    private NicType SelectedNic { get; set; } = NicType.Tcp4G;
    private int? HesTemplateId { get; set; }
    private string? ErrorMessage;
    private string? UploadMessage;

    /// <summary>
    /// The "(none)" select value. Empty string rather than null because MudSelect cannot bind a null
    /// item; <see cref="MeterRegistry"/> normalizes it straight back to null on the way in.
    /// </summary>
    private const string UnboundOption = "";

    private string SelectedBroker { get; set; } = UnboundOption;
    private string SelectedPushTarget { get; set; } = UnboundOption;

    // ── Rebind dialog ──
    private readonly DialogOptions _rebindOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool _rebindOpen;
    private MeterBatch? _rebindBatch;
    private string _rebindBroker = UnboundOption;
    private string _rebindPushTarget = UnboundOption;
    private string? _rebindError;

    // ── Add Batch dialog ──
    private readonly DialogOptions _addBatchDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private bool _addBatchOpen;

    // ── Upload Model dialog ──
    private readonly DialogOptions _uploadDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
    private bool _uploadOpen;

    private static string BindingLabel(string? key, bool exists) => key switch
    {
        null or "" => "— none",
        _ when !exists => $"{key} (MISSING from the registry)",
        _ => key,
    };

    /// <summary>
    /// The row's comm cell: which endpoint this batch talks through, and whether it is up.
    ///
    /// <para>
    /// The dot answers "is that endpoint connected right now" from the health monitor, so the two
    /// questions asked most often about a batch are both on the collapsed row. Grey is used for
    /// both unbound and not-yet-checked — neither is a failure, and colouring them red would cry
    /// wolf on a batch that was provisioned thirty seconds ago.
    /// </para>
    /// </summary>
    private (string Label, string Color, string Title) Comm(MeterBatch batch)
    {
        const string Green = "#4ec9b0";
        const string Red = "#f48771";
        const string Grey = "#8a8f98";

        bool isMqtt = NicTypes.IsMqtt(batch.NicType);
        string? key = isMqtt ? batch.BrokerKey : batch.PushTargetKey;

        if (string.IsNullOrWhiteSpace(key))
        {
            return isMqtt
                ? ("unbound", Grey, "No broker bound — this batch's meters are never reached.")
                : ("—", Grey, "No push target bound. Pulls work regardless; only push needs one.");
        }

        bool exists = isMqtt ? Network.Broker(key) is not null : Network.PushTarget(key) is not null;
        if (!exists)
        {
            return (key, Red, $"'{key}' is not in the network registry.");
        }

        return Health.For(key).Ok switch
        {
            true => (key, Green, $"{key} — connected."),
            false => (key, Red, $"{key} — {Health.For(key).Error ?? "unreachable"}"),
            null => (key, Grey, $"{key} — not checked yet."),
        };
    }

    /// <summary>Where the bound endpoint actually points — the part the row cannot show.</summary>
    private string BindingDetail(MeterBatch batch)
    {
        if (NicTypes.IsMqtt(batch.NicType))
        {
            return Network.Broker(batch.BrokerKey) is { } broker
                ? $"broker {broker.Describe()}"
                : $"broker: {BindingLabel(batch.BrokerKey, exists: false)}";
        }

        return Network.PushTarget(batch.PushTargetKey) is { } target
            ? $"push target {target.Describe()}"
            : $"push target: {BindingLabel(batch.PushTargetKey, exists: false)}";
    }

    private void OpenRebind(MeterBatch batch)
    {
        if (!IsAdmin)
        {
            return;
        }

        _rebindBatch = batch;
        _rebindBroker = batch.BrokerKey ?? UnboundOption;
        _rebindPushTarget = batch.PushTargetKey ?? UnboundOption;
        _rebindError = null;
        _rebindOpen = true;
    }

    private void SaveRebind()
    {
        if (!IsAdmin || _rebindBatch is null)
        {
            return;   // defense in depth — the button is admin-gated too
        }

        string? broker = string.IsNullOrWhiteSpace(_rebindBroker) ? null : _rebindBroker;
        string? push = string.IsNullOrWhiteSpace(_rebindPushTarget) ? null : _rebindPushTarget;

        if (!Bindings.Validate(_rebindBatch.NicType, broker, push, out string error))
        {
            _rebindError = error;
            return;
        }

        MeterRegistry.SetNetworkBinding(_rebindBatch.Id, broker, push);
        _rebindOpen = false;
        Snackbar.Add($"'{_rebindBatch.Name}' rebound.", Severity.Success);
    }

    private static readonly NicType[] AllNics = Enum.GetValues<NicType>();

    /// <summary>
    /// Batch ids whose detail panel is open. Kept by id rather than index so the open/closed state
    /// survives a batch being added or deleted underneath the table.
    /// </summary>
    private HashSet<int> ExpandedBatches { get; } = new();

    private void ToggleDetails(int batchId)
    {
        if (!ExpandedBatches.Remove(batchId))
        {
            ExpandedBatches.Add(batchId);
        }
    }

    /// <summary>
    /// Wirepas is the one NIC with a custom channel (endpoint 13) alongside plain DLMS, and the
    /// custom channel builds its own response — which needs HES's data model to lay out.
    ///
    /// Offered rather than required: the same meter answers DLMS on endpoint 3 with no data model
    /// at all, so demanding one would block a perfectly valid DLMS-only setup. Without it, custom
    /// requests are dropped with a stated reason.
    /// </summary>
    private static bool NeedsHesTemplateId(NicType nic) => nic == NicType.MqttWirepas;

    private static string NicLabel(NicType nic) => nic switch
    {
        NicType.Tcp4G => "4G TCP",
        NicType.Mqtt4G => "4G MQTT",
        NicType.Mqtt4GImg => "4G IMG MQTT",
        NicType.MqttWirepas => "RF Wirepas",
        NicType.MqttKmesh => "RF Kimbal Mesh",
        _ => nic.ToString(),
    };

    // Templates can be large (the full-model XML is ~4 MB); allow generous headroom for upload.
    private const long MaxUploadBytes = 32 * 1024 * 1024;

    private IReadOnlyList<string> Templates => TemplateRegistry.List();

    private string AddressPrefix => TcpOptionsAccessor.Value.AddressPrefix;

    // Utility role includes Viewer, and Admin role includes Utility+Viewer (see AuthEndpoints) -
    // checking a single role here correctly covers everyone entitled to that permission level.
    private bool IsAdmin => _user?.IsInRole(AppRoles.Admin) ?? false;
    private bool CanOperate => _user?.IsInRole(AppRoles.Utility) ?? false;

    private static Color StatusColor(BatchStatus status) => status switch
    {
        BatchStatus.Running => Color.Success,
        BatchStatus.Stopped => Color.Error,
        _ => Color.Default,
    };

    /// <summary>
    /// Row accent class per state. Paired with the status chip rather than replacing it — the
    /// accent is a muted left edge and a barely-there tint, so the table reads as scannable
    /// without turning into a traffic light.
    /// </summary>
    private static string StatusRowClass(BatchStatus status) => status switch
    {
        BatchStatus.Running => "is-running",
        BatchStatus.Stopped => "is-stopped",
        _ => "is-idle",
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            AuthenticationState state = await AuthStateTask;
            _user = state.User;
        }
    }

    private void AddBatch()
    {
        if (!IsAdmin)
        {
            return; // defense in depth - the button is hidden for non-admins, this shouldn't be reachable
        }

        ErrorMessage = null;

        // Keys only apply to the NIC that uses them — a stale selection left over from switching
        // the NIC dropdown must not be stored on a batch that can never use it.
        string? broker = NicTypes.IsMqtt(SelectedNic) && !string.IsNullOrWhiteSpace(SelectedBroker)
            ? SelectedBroker : null;
        string? pushTarget = SelectedNic == NicType.Tcp4G && !string.IsNullOrWhiteSpace(SelectedPushTarget)
            ? SelectedPushTarget : null;

        if (!Bindings.Validate(SelectedNic, broker, pushTarget, out string bindingError))
        {
            ErrorMessage = bindingError;
            return;
        }

        try
        {
            MeterRegistry.AddBatch(
                BatchName, SelectedTemplate, MeterCount, SelectedNic,
                NeedsHesTemplateId(SelectedNic) ? HesTemplateId : null,
                broker, pushTarget);
            BatchName = "";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            ErrorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Called from the dialog's "Add Batch" button. Delegates to <see cref="AddBatch"/> and closes
    /// the dialog on success (ErrorMessage is null after the call).
    /// </summary>
    private void AddBatchFromDialog()
    {
        AddBatch();
        if (ErrorMessage is null)
        {
            _addBatchOpen = false;
        }
    }

    private async Task OnTemplateUpload(IBrowserFile? file)
    {
        if (!IsAdmin || file is null)
        {
            return; // defense in depth
        }

        UploadMessage = null;
        try
        {
            await using Stream stream = file.OpenReadStream(MaxUploadBytes);
            string saved = await TemplateRegistry.SaveUploadAsync(file.Name, stream);
            SelectedTemplate = saved; // auto-select the just-uploaded template
            UploadMessage = $"Uploaded '{saved}'.";
        }
        catch (Exception ex)
        {
            UploadMessage = $"Upload failed: {ex.Message}";
        }
    }



    private void Start(int batchId)
    {
        if (CanOperate)
        {
            MeterRegistry.TryStart(batchId);
        }
    }

    private void Stop(int batchId)
    {
        if (CanOperate)
        {
            MeterRegistry.TryStop(batchId);
        }
    }

    private async Task Delete(int batchId)
    {
        if (!IsAdmin)
        {
            return;
        }

        MeterBatch? batch = MeterRegistry.Batches.FirstOrDefault(b => b.Id == batchId);
        if (batch is null)
        {
            return;
        }

        string meters = batch.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete batch?",
            $"Permanently delete \"{batch.Name}\" ({meters} meters)? " +
            "Its reserved IP / meter-number range is retired and will not be reused. This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        MeterRegistry.Delete(batchId);
    }

    /// <summary>
    /// Every meter across every batch in one file — what you register a whole fleet with, rather
    /// than downloading each batch and stitching them together.
    /// </summary>
    private async Task DownloadAllCsv() =>
        await JS.InvokeVoidAsync("mayaDownload", "/batches/meters.csv");

    private async Task DownloadCsv(int batchId) =>
        await JS.InvokeVoidAsync("mayaDownload", $"/batches/{batchId}/meters.csv");

    // ── Batch config import / export ──────────────────────────────────────────────────────────

    private const long MaxConfigBytes = 16 * 1024 * 1024;

    private async Task ExportBatches()
    {
        if (IsAdmin)
        {
            await JS.InvokeVoidAsync("mayaDownload", "/config/batches.json");
        }
    }

    private async Task OnBatchesFileSelected(InputFileChangeEventArgs e)
    {
        IBrowserFile? file = e.FileCount > 0 ? e.File : null;
        if (!IsAdmin || file is null)
        {
            return;
        }

        string json;
        try
        {
            await using Stream stream = file.OpenReadStream(MaxConfigBytes);
            using var reader = new StreamReader(stream);
            json = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not read the file: {ex.Message}", Severity.Error);
            return;
        }

        // Peek first (also rejects a wrong-kind file), then confirm — import REPLACES every batch
        // and rewrites the allocation cursor, so it is not something to do by half.
        int count;
        try
        {
            count = ConfigBundles.PreviewBatches(json);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Replace ALL batches?",
            $"This file holds {count} batch(es). Importing REPLACES every current batch, resets the " +
            "meter numbering to continue from the imported set, and clears live meter sessions. Batches " +
            "keep their broker / push-target bindings by name — import the network file too if those " +
            "endpoints are not already here. This cannot be undone.",
            yesText: "Replace batches", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            int applied = ConfigBundles.ImportBatches(json);
            // Live brain sessions belonged to the batches we just replaced — same as Reset all.
            Sessions.Clear();
            Snackbar.Add($"Imported {applied} batch(es).", Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ResetAll()
    {
        if (!IsAdmin)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset all batches?",
            "This permanently deletes ALL batches and restarts meter numbering from 1 (MY000000001). " +
            "Live meter sessions are cleared too. This cannot be undone.",
            yesText: "Reset everything", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        MeterRegistry.Reset();
        Sessions.Clear();
    }
}

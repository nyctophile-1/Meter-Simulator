@page "/batches"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ManyMeterSimulator.Auth
@using ManyMeterSimulator.Brain
@using ManyMeterSimulator.Networking.Nic
@using Microsoft.AspNetCore.Components.Forms
@inject MeterRegistry MeterRegistry
@inject TemplateRegistry TemplateRegistry
@inject MeterSessionManager Sessions
@inject IOptions<TcpOptions> TcpOptionsAccessor
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NetworkDelaySettings NetworkDelay
@inject IJSRuntime JS

<PageTitle>MAYA - Setup</PageTitle>

@* Network delay is deliberately absent here — it lives on the BadComm page with the other
   field-condition knobs, so there is only one place to read or change it. *@
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    TCP address prefix: <code>@AddressPrefix</code> &middot; max supported meters:
    <code>@MeterRegistry.MaxIndex.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</code>
    &middot; every meter has a node id whatever its NIC; only 4G TCP meters also get an IP
</MudText>

@if (IsAdmin)
{
    <MudPaper Elevation="1" Class="pa-4 mb-6">
        <MudText Typo="Typo.h6" GutterBottom="true">Provision a new batch</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6" md="2">
                <MudTextField T="string" @bind-Value="BatchName" Immediate="true"
                              Label="Batch name" Placeholder="e.g. batch-1"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudNumericField T="int" @bind-Value="MeterCount" Immediate="true" Min="1"
                                 Label="Number of meters (N)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            @* Widest column of the row: it holds full XML filenames, which truncated at md=3.
               Upload sits against the picker because that is the list it adds to — as a
               full-width button at the end of the row it read as an action on the whole form.
               HtmlTag="label" is required: MudFileUpload renders ActivatorContent inside a
               <label> for its hidden input, and a nested <button> swallows the click. *@
            <MudItem xs="12" sm="6" md="4">
                <div class="d-flex align-start" style="gap:6px;">
                    <MudSelect T="string" @bind-Value="SelectedTemplate" Label="Meter model (XML)"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1">
                        @foreach (string t in Templates)
                        {
                            <MudSelectItem Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                    <MudFileUpload T="IBrowserFile" Accept=".xml" FilesChanged="OnTemplateUpload"
                                   MaximumFileCount="1" Class="ma-0 flex-none">
                        <ActivatorContent>
                            <MudTooltip Text="Upload a meter model (.xml)">
                                <MudIconButton HtmlTag="label"
                                               Icon="@Icons.Material.Filled.UploadFile"
                                               Variant="Variant.Outlined" Color="Color.Default"
                                               Size="Size.Medium" aria-label="Upload a meter model" />
                            </MudTooltip>
                        </ActivatorContent>
                    </MudFileUpload>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="NicType" @bind-Value="SelectedNic" Label="NIC"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (NicType nic in AllNics)
                    {
                        <MudSelectItem Value="@nic">@NicLabel(nic)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @* Always rendered, disabled unless the NIC has a custom channel. Showing it
               conditionally reflowed the whole row the moment the NIC changed. *@
            <MudItem xs="12" sm="6" md="2">
                <MudNumericField T="int?" @bind-Value="HesTemplateId" Immediate="true" Min="1"
                                 Label="HES template id"
                                 Placeholder="e.g. 122"
                                 Disabled="@(!NeedsHesTemplateId(SelectedNic))"
                                 HelperText="@(NeedsHesTemplateId(SelectedNic)
                                     ? "Optional — needed only for the custom channel"
                                     : "Wirepas only")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        @if (Templates.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                No meter models found in the models folder.
            </MudAlert>
        }

        @if (UploadMessage is not null)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2">@UploadMessage</MudText>
        }

        @if (MeterCount > 0)
        {
            BatchPreview preview = MeterRegistry.PreviewNextBatch(AddressPrefix, MeterCount);
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                Will reserve node ids <code>@preview.FirstNodeId</code> &ndash; <code>@preview.LastNodeId</code>
                &middot; meter numbers <code>@preview.FirstSerial</code> &ndash; <code>@preview.LastSerial</code>
                @if (SelectedNic == NicType.Tcp4G)
                {
                    <text>&middot; IPs <code>@preview.FirstAddress</code> &ndash; <code>@preview.LastAddress</code></text>
                }
                (@MeterCount.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) meter(s))
            </MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddBatch"
                   Disabled="@(MeterCount <= 0 || string.IsNullOrWhiteSpace(BatchName) || string.IsNullOrWhiteSpace(SelectedTemplate))">
            Add Batch
        </MudButton>

        @if (ErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@ErrorMessage</MudAlert>
        }
    </MudPaper>
}

<div class="d-flex align-center justify-space-between mb-2" style="gap:12px;">
    <MudText Typo="Typo.h6" Class="mb-0">Batches (@MeterRegistry.Batches.Count)</MudText>
    @if (IsAdmin && MeterRegistry.Batches.Count > 0)
    {
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAll">Reset all batches</MudButton>
    }
</div>

@{
    IReadOnlyList<MeterBatch> batches = MeterRegistry.Batches;
}
@if (batches.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">None yet.</MudText>
}
else
{
    @* Only identity and state are on the row. The model, node-id / IP / meter-number ranges are
       reference detail — needed when registering meters with the HES, not when scanning the list
       — so they move into an expandable panel and stop forcing every range onto three lines. *@
    <MudSimpleTable Hover="true" Dense="true" Bordered="false" Class="batch-table">
        <thead>
            <tr>
                <th></th>
                <th></th>
                @* Absorbs all the slack, so the remaining columns stay grouped instead of
                   drifting apart into voids on a wide screen. *@
                <th class="col-flex">Name</th>
                <th>NIC</th>
                <th style="text-align:right">Count</th>
                <th>Status</th>
                @if (CanOperate)
                {
                    <th style="text-align:right">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (MeterBatch batch in batches)
            {
                bool expanded = ExpandedBatches.Contains(batch.Id);
                (string firstNode, string lastNode) = MeterRegistry.GetNodeIdRange(batch);
                @* The whole row is the hit target — a 24px chevron was a needlessly small one.
                   Cells holding their own controls stop propagation so Start/Stop/Delete and the
                   CSV download do not also toggle the panel. *@
                <tr class="batch-row @StatusRowClass(batch.Status) @(expanded ? "is-expanded" : "")"
                    @onclick="() => ToggleDetails(batch.Id)">
                    <td>
                        <MudIcon Size="Size.Small" Class="batch-chevron"
                                 Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                    </td>
                    <td @onclick:stopPropagation="true">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Download"
                                       Title="Download meter list (CSV)" OnClick="() => DownloadCsv(batch.Id)" />
                    </td>
                    <td class="col-flex">@batch.Name</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@NicLabel(batch.NicType)</MudChip>
                        @if (batch.HesTemplateId is int hesId)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">tpl @hesId</MudText>
                        }
                    </td>
                    <td style="text-align:right">@batch.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(batch.Status)">
                            @batch.Status
                        </MudChip>
                    </td>
                    @if (CanOperate)
                    {
                        <td style="text-align:right" @onclick:stopPropagation="true">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="() => Start(batch.Id)" Disabled="@(batch.Status == BatchStatus.Running)">Start</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" Class="ml-1"
                                       OnClick="() => Stop(batch.Id)" Disabled="@(batch.Status == BatchStatus.Stopped)">Stop</MudButton>
                            @if (IsAdmin)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error" Class="ml-1"
                                           OnClick="() => Delete(batch.Id)">Delete</MudButton>
                            }
                        </td>
                    }
                </tr>
                @if (expanded)
                {
                    <tr class="batch-detail-row @StatusRowClass(batch.Status)">
                        <td colspan="@(CanOperate ? 7 : 6)" class="pa-0">
                            <div class="pa-4">
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Meter model</MudText>
                                        <code>@batch.TemplateName</code>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Node id range</MudText>
                                        <code>@firstNode &ndash; @lastNode</code>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Meter# range</MudText>
                                        <code>@MeterRegistry.FormatSerial(batch.StartIndex) &ndash; @MeterRegistry.FormatSerial(batch.EndIndex)</code>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">IP range</MudText>
                                        @if (batch.NicType == NicType.Tcp4G)
                                        {
                                            (IPAddress firstAddr, IPAddress lastAddr) = MeterRegistry.GetAddressRange(batch, AddressPrefix);
                                            <code>@firstAddr &ndash; @lastAddr</code>
                                        }
                                        else
                                        {
                                            @* Only 4G TCP meters get an IP; the rest are reached by node id. *@
                                            <span class="mud-text-secondary">&mdash; not applicable on @NicLabel(batch.NicType)</span>
                                        }
                                    </MudItem>
                                </MudGrid>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ClaimsPrincipal? _user;

    private string BatchName { get; set; } = "";
    private int MeterCount { get; set; } = 100;
    private string SelectedTemplate { get; set; } = "";
    private NicType SelectedNic { get; set; } = NicType.Tcp4G;
    private int? HesTemplateId { get; set; }
    private string? ErrorMessage;
    private string? UploadMessage;

    private static readonly NicType[] AllNics = Enum.GetValues<NicType>();

    /// <summary>
    /// Batch ids whose detail panel is open. Kept by id rather than index so the open/closed state
    /// survives a batch being added or deleted underneath the table.
    /// </summary>
    private HashSet<int> ExpandedBatches { get; } = new();

    private void ToggleDetails(int batchId)
    {
        if (!ExpandedBatches.Remove(batchId))
        {
            ExpandedBatches.Add(batchId);
        }
    }

    /// <summary>
    /// Wirepas is the one NIC with a custom channel (endpoint 13) alongside plain DLMS, and the
    /// custom channel builds its own response — which needs HES's data model to lay out.
    ///
    /// Offered rather than required: the same meter answers DLMS on endpoint 3 with no data model
    /// at all, so demanding one would block a perfectly valid DLMS-only setup. Without it, custom
    /// requests are dropped with a stated reason.
    /// </summary>
    private static bool NeedsHesTemplateId(NicType nic) => nic == NicType.MqttWirepas;

    private static string NicLabel(NicType nic) => nic switch
    {
        NicType.Tcp4G => "4G TCP",
        NicType.Mqtt4G => "4G MQTT",
        NicType.Mqtt4GImg => "4G IMG MQTT",
        NicType.MqttWirepas => "RF Wirepas",
        NicType.MqttKmesh => "RF Kmesh",
        _ => nic.ToString(),
    };

    // Templates can be large (the full-model XML is ~4 MB); allow generous headroom for upload.
    private const long MaxUploadBytes = 32 * 1024 * 1024;

    private IReadOnlyList<string> Templates => TemplateRegistry.List();

    private string AddressPrefix => TcpOptionsAccessor.Value.AddressPrefix;

    // Utility role includes Viewer, and Admin role includes Utility+Viewer (see AuthEndpoints) -
    // checking a single role here correctly covers everyone entitled to that permission level.
    private bool IsAdmin => _user?.IsInRole(AppRoles.Admin) ?? false;
    private bool CanOperate => _user?.IsInRole(AppRoles.Utility) ?? false;

    private static Color StatusColor(BatchStatus status) => status switch
    {
        BatchStatus.Running => Color.Success,
        BatchStatus.Stopped => Color.Error,
        _ => Color.Default,
    };

    /// <summary>
    /// Row accent class per state. Paired with the status chip rather than replacing it — the
    /// accent is a muted left edge and a barely-there tint, so the table reads as scannable
    /// without turning into a traffic light.
    /// </summary>
    private static string StatusRowClass(BatchStatus status) => status switch
    {
        BatchStatus.Running => "is-running",
        BatchStatus.Stopped => "is-stopped",
        _ => "is-idle",
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            AuthenticationState state = await AuthStateTask;
            _user = state.User;
        }
    }

    private void AddBatch()
    {
        if (!IsAdmin)
        {
            return; // defense in depth - the button is hidden for non-admins, this shouldn't be reachable
        }

        ErrorMessage = null;

        try
        {
            MeterRegistry.AddBatch(
                BatchName, SelectedTemplate, MeterCount, SelectedNic,
                NeedsHesTemplateId(SelectedNic) ? HesTemplateId : null);
            BatchName = "";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task OnTemplateUpload(IBrowserFile? file)
    {
        if (!IsAdmin || file is null)
        {
            return; // defense in depth
        }

        UploadMessage = null;
        try
        {
            await using Stream stream = file.OpenReadStream(MaxUploadBytes);
            string saved = await TemplateRegistry.SaveUploadAsync(file.Name, stream);
            SelectedTemplate = saved; // auto-select the just-uploaded template
            UploadMessage = $"Uploaded '{saved}'.";
        }
        catch (Exception ex)
        {
            UploadMessage = $"Upload failed: {ex.Message}";
        }
    }

    private void Start(int batchId)
    {
        if (CanOperate)
        {
            MeterRegistry.TryStart(batchId);
        }
    }

    private void Stop(int batchId)
    {
        if (CanOperate)
        {
            MeterRegistry.TryStop(batchId);
        }
    }

    private async Task Delete(int batchId)
    {
        if (!IsAdmin)
        {
            return;
        }

        MeterBatch? batch = MeterRegistry.Batches.FirstOrDefault(b => b.Id == batchId);
        if (batch is null)
        {
            return;
        }

        string meters = batch.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete batch?",
            $"Permanently delete \"{batch.Name}\" ({meters} meters)? " +
            "Its reserved IP / meter-number range is retired and will not be reused. This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        MeterRegistry.Delete(batchId);
    }

    private async Task DownloadCsv(int batchId) =>
        await JS.InvokeVoidAsync("mayaDownload", $"/batches/{batchId}/meters.csv");

    private async Task ResetAll()
    {
        if (!IsAdmin)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset all batches?",
            "This permanently deletes ALL batches and restarts meter numbering from 1 (MY000000001). " +
            "Live meter sessions are cleared too. This cannot be undone.",
            yesText: "Reset everything", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        MeterRegistry.Reset();
        Sessions.Clear();
    }
}

@using ManyMeterSimulator.Brain
@inject MeterRegistry Meters
@inject TemplateRegistry Templates
@inject ManyMeterSimulator.Networking.CustomPush.CustomPushEncoder CustomEncoder

<MudSelect T="string" Label="Profile" Value="@(MqttPushProfiles.Canonical(Value) ?? "all")" ValueChanged="ValueChanged" Disabled="@Disabled" Variant="Variant.Outlined" Margin="Margin.Dense">
    <MudSelectItem T="string" Value='@("all")'>All supported profiles</MudSelectItem>
    @foreach (var profile in _profiles)
    {
        <MudSelectItem T="string" Value="@profile.LogicalName">@profile.Label (@profile.LogicalName)</MudSelectItem>
    }
</MudSelect>
<MudText Typo="Typo.caption">Wirepas sends custom push; all other NICs send DLMS. Profiles shown are supported by every selected batch.</MudText>
@if (_error is not null) { <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText> }

@code {
    [Parameter] public IEnumerable<int> BatchIds { get; set; } = [];
    [Parameter] public string Value { get; set; } = "all";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private IReadOnlyList<MqttPushProfile> _profiles = [];
    private string? _signature, _error;

    protected override void OnParametersSet()
    {
        var batches = Meters.Batches.Where(b => BatchIds.Contains(b.Id)).ToArray();
        string signature = string.Join("|", batches.Select(b => $"{b.Id}:{b.TemplateName}:{b.NicType}:{b.HesTemplateId}:{b.CustomPushHeaderKind}"));
        if (_signature == signature) return;
        _signature = signature;
        _error = null;
        HashSet<string>? common = null;
        foreach (var batch in batches)
        {
            var profiles = new List<MqttPushProfile>();
            try
            {
                if (batch.NicType == ManyMeterSimulator.Networking.Nic.NicType.MqttWirepas)
                {
                    if (batch.CustomPushHeaderKind is not (null or ManyMeterSimulator.Networking.CustomPush.CustomPushHeaderKind.New))
                        throw new InvalidOperationException("Custom push requires the supported 12-byte HES header.");
                    profiles.AddRange(CustomEncoder.GetProfiles(batch.HesTemplateId
                        ?? throw new InvalidOperationException("Wirepas custom push requires a HES template mapping."))
                        .Select(p => new MqttPushProfile(MqttPushProfiles.Canonical(p.Key)!, p.Label)));
                }
                else profiles.AddRange(MqttPushProfiles.ReadTemplate(Templates.ResolveOrThrow(batch.TemplateName)));
            }
            catch (Exception ex) { _error = $"Cannot read profiles for {batch.Name}: {ex.Message}"; }
            var keys = profiles.Select(p => p.LogicalName).ToHashSet(StringComparer.Ordinal);
            if (common is null) common = keys;
            else common.IntersectWith(keys);
        }
        _profiles = (common ?? []).Select(ln => new MqttPushProfile(ln, MqttPushProfiles.Label(ln)))
            .OrderBy(p => p.Label).ToArray();
    }
}

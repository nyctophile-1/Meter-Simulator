@using ManyMeterSimulator.Provisioning
@using ManyMeterSimulator.Networking.Registry
@using Microsoft.AspNetCore.Components.Authorization
@using Npgsql
@implements IDisposable
@inject MeterRegistry Meters
@inject NetworkRegistry Network
@inject HesBatchRegistrationService Registration

@if (IsAdmin)
{
    <MudPaper Class="pa-4 mt-6" Outlined="true">
        <MudText Typo="Typo.h6">HES batch provisioning</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">Select a stopped batch and database, edit the registration preview, then review and submit. Historical data is preserved.</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3">
            <MudSelect T="int?" Label="Batch" Placeholder="Select a batch" Value="_batchId" ValueChanged="SelectBatch" Disabled="_busy" Style="min-width:220px">
                @foreach (var batch in Meters.Batches)
                {
                    <MudSelectItem T="int?" Value="@((int?)batch.Id)">@batch.Name (@batch.Count.ToString("N0") meters; @batch.Status)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="PostgreSQL database" @bind-Value="_databaseKey" Disabled="_busy" Style="min-width:220px">
                @foreach (var db in Network.Databases.Where(d => d.Provider == DatabaseProvider.PostgreSql))
                {
                    <MudSelectItem Value="@db.Key">@db.Key</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="int?" Label="HES template ID" @bind-Value="_templateId" Min="1" Disabled="@(_busy || Meters.Batches.FirstOrDefault(b => b.Id == _batchId)?.HesTemplateId is > 0)" />
        </MudStack>
        <MudButton OnClick="Preview" Disabled="@(_busy || _batchId is null || string.IsNullOrWhiteSpace(_databaseKey) || _templateId is not > 0)" Variant="Variant.Outlined">Preview registration</MudButton>
        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
            <MudButton OnClick="Cancel">Cancel operation</MudButton>
        }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        @if (_preview is { } p && _previewBatch == _batchId && _previewDatabase == _databaseKey && p.TemplateId == _templateId && _draft is { } draft)
        {
            <MudSimpleTable Dense="true" Class="mt-3">
                <tbody>
                    <tr><td>Verified target</td><td>@p.Inspection.Target</td></tr>
                    <tr><td>Batch / nodes</td><td>@p.BatchName: @p.FirstNode – @p.LastNode (@p.Count.ToString("N0"))</td></tr>
                    <tr><td>HES template</td><td>@p.TemplateId</td></tr>
                    <tr><td>Communication module</td><td>@p.Module</td></tr>
                    <tr><td>Device IDs</td><td>@p.FirstDeviceId – @p.LastDeviceId</td></tr>
                    <tr><td>Installed on / original installed on</td><td>Both set to UTC now when submitted</td></tr>
                    <tr><td>Route</td><td>@p.Route</td></tr>
                    <tr><td>First meter address</td><td>@p.FirstAddress : @p.Port</td></tr>
                    <tr><td>Model SHA-256</td><td style="overflow-wrap:anywhere">@p.ModelHash</td></tr>
                    <tr><td>Remove existing rows</td><td>Nameplate @p.Inspection.Existing.Nameplates; security @p.Inspection.Existing.Security; routing @p.Inspection.Existing.Routes</td></tr>
                    <tr><td>Insert rows</td><td>@p.Count.ToString("N0") in each table</td></tr>
                    <tr><td>Security</td><td>Simulator demo profile • values hidden</td></tr>
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">Edit registration values</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">Values apply to every meter in this registration. Select a matching batch meter model for D2/D3 payloads.</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" Label="Meter category" @bind-Value="draft.Category" Disabled="_busy" Variant="Variant.Outlined">
                        @foreach (var category in new[] { "D1", "D2", "D3" }) { <MudSelectItem Value="@category">@category</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4"><MudTextField T="string" Label="Meter type" @bind-Value="draft.MeterType" Immediate="true" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="int" Label="Block capture period (minutes)" @bind-Value="draft.CapturePeriodMinutes" Disabled="_busy" Variant="Variant.Outlined">
                        @foreach (int period in new[] { 15, 30, 60 }) { <MudSelectItem Value="@period">@period minutes</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="int" Label="CT ratio" @bind-Value="draft.CtRatio" Immediate="true" Min="1" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="int" Label="PT ratio" @bind-Value="draft.PtRatio" Immediate="true" Min="1" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="4"><MudNumericField T="int?" Label="Year of manufacture" @bind-Value="draft.Year" Immediate="true" Min="1900" Max="9999" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField T="string" Label="Manufacturer" @bind-Value="draft.Manufacturer" Immediate="true" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField T="string" Label="Firmware" @bind-Value="draft.Firmware" Immediate="true" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="4"><MudTextField T="string" Label="Current rating" @bind-Value="draft.Rating" Immediate="true" MaxLength="10" Disabled="_busy" Variant="Variant.Outlined" /></MudItem>
            </MudGrid>
            <MudText Typo="Typo.body2" Class="mt-2">Replacement briefly locks the three registration tables. Run during a test maintenance window. Routes start with iscommunicating=false; HES parsing and persistence still need verification.</MudText>
            @foreach (var issue in p.Inspection.Issues) { <MudAlert Severity="Severity.Error">@issue</MudAlert> }
            @if (p.Inspection.LegacyMeters > 0)
            {
                <MudCheckBox T="bool" @bind-Value="_adoptLegacy" Disabled="_busy" Label="@($"I confirm these {p.Inspection.LegacyMeters:N0} matching legacy registrations belong to MAYA and may be replaced.")" />
            }
            <MudButton OnClick="Replace" Color="Color.Error" Variant="Variant.Filled" Class="mt-3"
                Disabled="@(_busy || p.Inspection.Conflicts > 0 || p.Inspection.LegacyMeters > 0 && !_adoptLegacy)">Review and submit</MudButton>
        }
        @if (_receipt is { } receipt)
        {
            <MudAlert Severity="Severity.Success" Class="mt-3">@receipt.State. Inserted @receipt.Count.ToString("N0") rows per table. Receipt: @receipt.OperationId.</MudAlert>
            @if (receipt.Warning is not null) { <MudAlert Severity="Severity.Warning">@receipt.Warning</MudAlert> }
        }
    </MudPaper>
    <MudDialog @bind-Visible="_confirmOpen" Options="_dialogOptions">
        <TitleContent><MudText Typo="Typo.h6">Confirm HES batch registration</MudText></TitleContent>
        <DialogContent>
            @if (_confirmedPreview is { } c)
            {
                var v = c.EditableValues;
                <MudText>@c.BatchName — @c.Count.ToString("N0") meters in @c.Inspection.Target</MudText>
                <MudSimpleTable Dense="true" Class="mt-3"><tbody>
                    <tr><td>Nodes</td><td>@c.FirstNode – @c.LastNode</td></tr>
                    <tr><td>HES template / category / meter type</td><td>@c.TemplateId / @v.Category / @v.MeterType</td></tr>
                    <tr><td>CT / PT ratio</td><td>@v.CtRatio / @v.PtRatio</td></tr>
                    <tr><td>Block capture period</td><td>@v.CapturePeriodMinutes minutes</td></tr>
                    <tr><td>Manufacturer / firmware</td><td>@v.Manufacturer / @v.Firmware</td></tr>
                    <tr><td>Rating / manufacture year</td><td>@v.Rating / @v.Year</td></tr>
                    <tr><td>Device IDs</td><td>@c.FirstDeviceId – @c.LastDeviceId</td></tr>
                    <tr><td>Communication module</td><td>@c.Module</td></tr>
                    <tr><td>Route</td><td>@c.Route</td></tr>
                    <tr><td>Installed on / original installed on</td><td>UTC now at submission</td></tr>
                    <tr><td>Rows to remove</td><td>Nameplate @c.Inspection.Existing.Nameplates; security @c.Inspection.Existing.Security; routing @c.Inspection.Existing.Routes</td></tr>
                    <tr><td>Rows to insert</td><td>@c.Count.ToString("N0") per table</td></tr>
                </tbody></MudSimpleTable>
                <MudText Class="mt-3">Submit replaces these registrations atomically. Other meters and historical data are preserved.</MudText>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="() => _reviewCompletion?.TrySetResult(false)">Back to edit</MudButton>
            <MudButton OnClick="() => _reviewCompletion?.TrySetResult(true)" Color="Color.Error" Variant="Variant.Filled">Confirm and submit</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter] public bool IsAdmin { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private int? _batchId, _templateId, _previewBatch;
    private string _databaseKey = "", _previewDatabase = "";
    private bool _busy, _adoptLegacy;
    private string? _error;
    private HesRegistrationPreview? _preview;
    private HesRegistrationEdits? _draft;
    private HesRegistrationPreview? _confirmedPreview;
    private bool _confirmOpen;
    private TaskCompletionSource<bool>? _reviewCompletion;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false };
    private HesRegistrationReceipt? _receipt;
    private CancellationTokenSource? _cancel;
    private void SelectBatch(int? id)
    {
        _batchId = id;
        _templateId = Meters.Batches.FirstOrDefault(b => b.Id == id)?.HesTemplateId;
        _preview = null;
    }
    private async Task Preview() => await Run(async ct =>
    {
        _preview = null; _receipt = null; _adoptLegacy = false;
        _preview = await Registration.PreviewAsync((await AuthenticationStateTask).User, _batchId!.Value, _databaseKey, _templateId!.Value, ct);
        _draft = _preview.EditableValues;
        _previewBatch = _batchId; _previewDatabase = _databaseKey;
    });
    private async Task Replace() => await Run(async ct =>
    {
        if (_preview is null || _draft is null) return;
        var preview = Registration.RevisePreview((await AuthenticationStateTask).User, _preview, _draft);
        bool adoptLegacy = _adoptLegacy;
        _confirmedPreview = preview;
        _reviewCompletion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        _confirmOpen = true;
        await InvokeAsync(StateHasChanged);
        bool yes;
        using (ct.Register(() => _reviewCompletion?.TrySetCanceled(ct)))
        {
            try { yes = await _reviewCompletion.Task; }
            finally { _confirmOpen = false; _reviewCompletion = null; _confirmedPreview = null; }
        }
        if (!yes) return;
        _preview = null;
        _receipt = await Registration.ReplaceAsync((await AuthenticationStateTask).User, preview, adoptLegacy, ct);
    });
    private async Task Run(Func<CancellationToken, Task> action)
    {
        if (_busy || !IsAdmin) return;
        _busy = true; _error = null;
        _cancel = new();
        try { await action(_cancel.Token); }
        catch (RegistrationCommitUncertainException ex) { _error = ex.Message; }
        catch (OperationCanceledException) { _error = "Operation cancelled or timed out. No replacement was committed."; }
        catch (PostgresException ex) { _error = $"PostgreSQL rejected the operation (SQLSTATE {ex.SqlState}). Check target permissions/schema or concurrent activity, then preview again."; }
        catch (NpgsqlException) { _error = "Database connection failed. Check the saved connection, TLS settings and network, then preview again."; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        catch (UnauthorizedAccessException) { _error = "Administrator access is required, and the receipt folder must be writable."; }
        catch { _error = "Could not prepare the batch registration. Check the model and server configuration."; }
        finally { _busy = false; _cancel.Dispose(); _cancel = null; }
    }
    private void Cancel() => _cancel?.Cancel();
    public void Dispose() => _cancel?.Cancel();
}
